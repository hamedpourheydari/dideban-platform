    $.confirm.click({title:'شروع به‌روزرسانی',class:'btn-success'},function(){$.softwareUpdate.progress({stage:'starting',percent:0});$.ccio.cx({f:'software_update',ff:'auto_install'})})
    $.confirm.e.modal('show')
})
$.softwareUpdate.compareVersions=function(a,b){
    var ap=String(a||'0').replace(/^v/i,'').split('-')[0].split('.'),bp=String(b||'0').replace(/^v/i,'').split('-')[0].split('.'),n=Math.max(ap.length,bp.length)
    for(var i=0;i<n;i++){var av=parseInt(ap[i]||0,10)||0,bv=parseInt(bp[i]||0,10)||0;if(av>bv)return 1;if(av<bv)return -1}return 0
}
$.softwareUpdate.e.on('click','.update-offline',function(){
    $.softwareUpdate.e.find('.update-offline-file').val('').trigger('click')
})
$.softwareUpdate.e.on('change','.update-offline-file',function(){
    var file=this.files&&this.files[0]
    if(!file)return
    if(!/\.zip$/i.test(file.name)){return $.softwareUpdate.error('فقط فایل ZIP بسته به‌روزرسانی دیده‌بان قابل انتخاب است.')}
    $.softwareUpdate.offlineFile=file
    $.confirm.title.html('بارگذاری بسته آفلاین')
    $.confirm.body.html('<p>فایل <b></b> از USB یا دیسک محلی بارگذاری و سپس ساختار، محصول و نسخه آن بررسی می‌شود.</p><p>تا پایان بارگذاری صفحه را نبندید.</p>').find('b').text(file.name)
    $.confirm.click({title:'بررسی بسته',class:'btn-warning'},function(){
        $.softwareUpdate.progress({stage:'offline_prepare',percent:0})
        $.ccio.cx({f:'software_update',ff:'offline_prepare'})
    })
    $.confirm.e.modal('show')
})
$.softwareUpdate.uploadOffline=function(d){
    var file=this.offlineFile
    if(!file)return this.error('فایل بسته آفلاین انتخاب نشده است.')
    if(d.maxBytes&&file.size>d.maxBytes)return this.error('حجم فایل بیشتر از حد مجاز سامانه است.')
    var xhr=new XMLHttpRequest(),self=this
    xhr.open('POST',d.url,true)
    xhr.setRequestHeader('Content-Type','application/octet-stream')
    xhr.setRequestHeader('X-Dideban-File-Name',encodeURIComponent(file.name))
    xhr.upload.onprogress=function(e){self.progress({stage:'offline_upload',receivedBytes:e.loaded,totalBytes:e.total||file.size,percent:e.lengthComputable?Math.floor(e.loaded*100/e.total):null})}
    xhr.onerror=function(){self.error('ارتباط هنگام بارگذاری بسته آفلاین قطع شد.')}
    xhr.onload=function(){
        if(xhr.status<200||xhr.status>=300){var msg='بارگذاری بسته آفلاین ناموفق بود.';try{msg=JSON.parse(xhr.responseText).msg||msg}catch(e){};self.error(msg)}
        else{self.e.find('.update-progress-label').text('بارگذاری کامل شد؛ در حال بررسی ساختار بسته...')}
    }
    xhr.send(file)
}
$.softwareUpdate.offlineReady=function(d){
    this.offlinePackage=d
    this.setBusy(false)
    this.e.find('.update-auto,.update-offline,.update-check').prop('disabled',false)
    this.e.find('.update-progress-wrap').show().find('.update-progress-bar').css('width','100%')
    this.e.find('.update-progress-percent').text('100%')
    this.e.find('.update-progress-label').text('بسته آفلاین بررسی شد — '+this.formatBytes(d.size))
    this.e.find('.latest-version').text(d.version||'نامشخص')
    this.e.find('.update-status').removeClass('warning danger').addClass('success').html('<i class="fa fa-check-circle"></i><span></span>').find('span').text(d.message)
    var changes=Array.isArray(d.changelog)?d.changelog:[],list=this.e.find('.update-changelog ul').empty()
    changes.forEach(function(x){$('<li>').text(x).appendTo(list)});this.e.find('.update-changelog').toggle(changes.length>0)
    var cmp=this.compareVersions(d.version,d.currentVersion),warning=''
    if(cmp<0)warning='<p class="text-danger"><b>هشدار:</b> نسخه انتخاب‌شده قدیمی‌تر از نسخه نصب‌شده است و نصب آن به معنی بازگشت نسخه خواهد بود.</p>'
    else if(cmp===0)warning='<p class="text-warning"><b>توجه:</b> نسخه انتخاب‌شده با نسخه فعلی یکسان است.</p>'
    $.confirm.title.html('نصب بسته آفلاین دیده‌بان')
    $.confirm.body.html('<p>نسخه فعلی: <b class="offline-current"></b></p><p>نسخه بسته: <b class="offline-new"></b></p>'+warning+'<p>پس از تأیید، سامانه بکاپ می‌گیرد، فایل‌ها را نصب می‌کند و سرویس را دوباره راه‌اندازی می‌کند. داده‌های کاربران محفوظ می‌ماند.</p>')
    $.confirm.body.find('.offline-current').text(d.currentVersion);$.confirm.body.find('.offline-new').text(d.version)
    $.confirm.click({title:cmp<0?'بازگشت به این نسخه':'نصب و راه‌اندازی مجدد',class:cmp<0?'btn-danger':'btn-success'},function(){
        $.softwareUpdate.progress({stage:'offline_install',percent:100})
        $.ccio.cx({f:'software_update',ff:'offline_install',package:d})
    })
    $.confirm.e.modal('show')
}
$.softwareUpdate.installing=function(d){
    this.e.find('.update-auto,.update-offline,.update-check').prop('disabled',true)
    this.e.find('.update-progress-wrap').show().find('.update-progress-bar').css('width','100%')
