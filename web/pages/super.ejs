                    <div class="update-progress-wrap"><div class="update-progress-track"><div class="update-progress-bar"></div></div><div class="update-progress-text"><span class="update-progress-label">در حال آماده‌سازی...</span><span class="update-progress-percent">0%</span></div></div>
