<style>
:root{
    --super-bg:#07111c;
    --super-panel:#111d2a;
    --super-panel-2:#162434;
    --super-border:rgba(148,163,184,.18);
    --super-text:#e8eef6;
    --super-muted:#8fa1b5;
    --super-green:#35c77a;
    --super-green-dark:#22965a;
    --super-blue:#4aa3ff;
    --super-red:#ef6464;
    --super-shadow:0 22px 55px rgba(0,0,0,.28);
}
*{box-sizing:border-box}
body.super-page{
    direction:rtl;
    min-height:100vh;
    margin:0;
    color:var(--super-text);
    background:
        radial-gradient(circle at 8% 5%,rgba(53,199,122,.13),transparent 31%),
        radial-gradient(circle at 92% 90%,rgba(53,199,122,.10),transparent 29%),
        linear-gradient(135deg,#07111c 0%,#0a1521 52%,#08131d 100%);
    font-family:Tahoma,Arial,sans-serif;
}
body.super-page:before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    opacity:.24;
    background-image:radial-gradient(rgba(81,210,141,.35) 1px,transparent 1px);
    background-size:24px 24px;
    mask-image:linear-gradient(135deg,#000,transparent 48%);
}
.super-shell{position:relative;z-index:1;max-width:1280px;margin:0 auto;padding:32px 24px 48px}
.super-topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    min-height:78px;
    padding:14px 20px;
    margin-bottom:20px;
    border:1px solid var(--super-border);
    border-radius:18px;
    background:rgba(17,29,42,.88);
    backdrop-filter:blur(16px);
    box-shadow:var(--super-shadow);
}
.super-brand{display:flex;align-items:center;gap:14px;color:var(--super-text)!important;text-decoration:none!important}
.super-brand-logo{width:48px;height:48px;object-fit:contain;padding:5px;border-radius:14px;background:rgba(53,199,122,.10);border:1px solid rgba(53,199,122,.25)}
.super-brand-copy{display:flex;flex-direction:column;gap:3px}
.super-brand-copy strong{font-size:18px;font-weight:800}
.super-brand-copy small{font-size:12px;color:var(--super-muted)}
.super-menu{position:relative}
.super-menu .dropdown-toggle{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;color:var(--super-text)!important;background:rgba(255,255,255,.04);border:1px solid var(--super-border)}
.super-menu .dropdown-menu{right:auto;left:0;min-width:180px;padding:8px;border:1px solid var(--super-border);border-radius:12px;background:#142130;box-shadow:0 16px 35px rgba(0,0,0,.28)}
.super-menu .dropdown-menu a{color:var(--super-text);padding:10px 12px;border-radius:8px;cursor:pointer}
.super-menu .dropdown-menu a:hover{background:rgba(239,100,100,.12);color:#ff9b9b}
.super-intro{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    padding:22px 24px;
    margin-bottom:20px;
    border:1px solid var(--super-border);
    border-radius:18px;
    background:linear-gradient(135deg,rgba(53,199,122,.11),rgba(74,163,255,.05));
}
.super-intro h1{font-size:24px;margin:0 0 8px;font-weight:800}
.super-intro p{margin:0;color:var(--super-muted);font-size:13px;line-height:1.9}
.super-status{display:flex;align-items:center;gap:9px;white-space:nowrap;padding:9px 13px;border-radius:999px;color:#9ce9bd;background:rgba(53,199,122,.10);border:1px solid rgba(53,199,122,.24);font-size:12px;font-weight:700}
.super-status i{font-size:9px;color:var(--super-green);filter:drop-shadow(0 0 5px rgba(53,199,122,.8))}
.super-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:20px}
.super-stat{display:flex;align-items:center;gap:13px;padding:16px 18px;border:1px solid var(--super-border);border-radius:16px;background:rgba(17,29,42,.82)}
.super-stat-icon{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:12px;color:var(--super-green);background:rgba(53,199,122,.10);font-size:18px}
.super-stat strong{display:block;font-size:20px;line-height:1.1}
.super-stat span{display:block;margin-top:5px;color:var(--super-muted);font-size:11px}
.super-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);gap:20px;align-items:start}
.super-column{display:flex;flex-direction:column;gap:20px;min-width:0}
.super-pair-row{grid-column:1 / -1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:stretch;min-width:0}
.super-pair-row>.super-card{height:100%;margin:0}
.super-card{overflow:hidden;border:1px solid var(--super-border);border-radius:18px;background:rgba(17,29,42,.94);box-shadow:var(--super-shadow)}
.super-card-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:17px 19px;border-bottom:1px solid var(--super-border);background:rgba(255,255,255,.018)}
.super-card-title{display:flex;align-items:center;gap:10px;margin:0;font-size:15px;font-weight:800;color:var(--super-text)}
.super-card-title .icon{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;color:var(--super-green);background:rgba(53,199,122,.10)}
.super-card-subtitle{color:var(--super-muted);font-size:11px;font-weight:400}
.super-card-body{padding:14px 16px}
.super-action{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;border:1px solid rgba(53,199,122,.25);border-radius:10px;color:#a7edc4!important;background:rgba(53,199,122,.10);transition:.18s ease}
.super-action:hover{transform:translateY(-1px);background:rgba(53,199,122,.18)}
.super-action.danger{color:#ffadad!important;border-color:rgba(239,100,100,.23);background:rgba(239,100,100,.09)}
.super-table-wrap{overflow:auto;min-height:98px}
.super-page .table{margin:0;color:var(--super-text);background:transparent}
.super-page .table>tbody>tr>td{vertical-align:middle;padding:13px 8px;border-top:1px solid rgba(148,163,184,.11);background:transparent!important}
.super-page .table>tbody>tr:first-child>td{border-top:0}
.super-page .table-striped>tbody>tr:nth-of-type(odd){background:rgba(255,255,255,.018)}
.super-page .mail{color:#f3f7fb;font-size:13px}
.super-page .btn-xs{border:0;border-radius:8px;padding:6px 9px}
.super-page .btn-primary{background:#347fbd}.super-page .btn-danger{background:#d95151}.super-page .btn-success{background:var(--super-green-dark)}
.logs-body{height:420px;overflow:auto;padding:0 12px 12px}
.logs-empty{padding:55px 18px;text-align:center;color:var(--super-muted);font-size:12px}
.config-card .super-card-body{padding:16px}
.config-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px}
.config-file{display:flex;align-items:center;gap:8px;color:var(--super-muted);font:12px Consolas,monospace}
#conf_json textarea{
    direction:ltr;
    text-align:left;
    height:390px!important;
    resize:vertical;
    padding:17px;
    color:#dbe8f5;
    caret-color:var(--super-green);
    background:#09131e;
    border:1px solid rgba(148,163,184,.22);
    border-radius:13px;
    font:13px/1.75 Consolas,"Courier New",monospace;
    box-shadow:inset 0 0 0 1px rgba(0,0,0,.12);
}
#conf_json textarea:focus{border-color:rgba(53,199,122,.64);box-shadow:0 0 0 3px rgba(53,199,122,.11)}
.config-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px}
.config-hint{color:var(--super-muted);font-size:11px}
.super-save{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border:0;border-radius:11px!important;font-weight:700;box-shadow:0 8px 20px rgba(34,150,90,.2)}
.system-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.system-actions .btn{white-space:normal;padding:12px 8px;border-radius:11px!important;border:1px solid rgba(239,100,100,.22);color:#ffc0c0;background:rgba(239,100,100,.11);font-size:12px}
.system-actions .btn:hover{color:#fff;background:rgba(239,100,100,.22)}
.super-warning{display:flex;gap:10px;margin-top:13px;padding:11px 12px;border-radius:11px;color:#d9b979;background:rgba(234,179,8,.07);border:1px solid rgba(234,179,8,.13);font-size:11px;line-height:1.8}
.form-group label>div:first-child{width:40%}
.config-tabs{display:flex;gap:8px;overflow:auto;padding:0 0 14px;margin-bottom:16px;border-bottom:1px solid var(--super-border)}
.config-tab{flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;padding:9px 13px;border:1px solid var(--super-border);border-radius:10px;color:var(--super-muted);background:rgba(255,255,255,.025);font-size:12px;font-weight:700;cursor:pointer;transition:.18s ease}
.config-tab:hover{color:var(--super-text);background:rgba(255,255,255,.05)}
.config-tab.active{color:#a7edc4;border-color:rgba(53,199,122,.34);background:rgba(53,199,122,.12)}
.config-pane{display:none}.config-pane.active{display:block}
.settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.settings-grid.one{grid-template-columns:1fr}
.setting-field{min-width:0}
.setting-field.full{grid-column:1/-1}
.setting-field label{display:block;margin:0 0 7px;color:#cbd7e4;font-size:11px;font-weight:700}
.setting-field .field-help{display:block;margin-top:6px;color:var(--super-muted);font-size:10px;line-height:1.7}
.setting-input,.setting-select{width:100%;height:42px;padding:8px 11px;color:var(--super-text);background:#0a1520;border:1px solid rgba(148,163,184,.22);border-radius:10px;outline:none;transition:.18s ease}
.setting-input:focus,.setting-select:focus{border-color:rgba(53,199,122,.64);box-shadow:0 0 0 3px rgba(53,199,122,.10)}
.setting-select option{color:#182330;background:#fff}
.password-wrap{position:relative}.password-wrap .setting-input{padding-left:42px}.password-toggle{position:absolute;left:4px;top:4px;width:34px;height:34px;border:0;border-radius:8px;color:var(--super-muted);background:transparent}.password-toggle:hover{color:var(--super-text);background:rgba(255,255,255,.06)}
.config-section-title{display:flex;align-items:center;gap:10px;margin:0 0 14px;padding-bottom:11px;border-bottom:1px solid rgba(148,163,184,.11);font-size:13px;font-weight:800}.config-section-title i{color:var(--super-green)}
.storage-list{display:flex;flex-direction:column;gap:10px}.storage-row{display:grid;grid-template-columns:minmax(120px,.65fr) minmax(220px,1.5fr) 38px;gap:9px;align-items:end;padding:11px;border:1px solid rgba(148,163,184,.15);border-radius:12px;background:rgba(255,255,255,.018)}
.storage-remove{height:38px;border:1px solid rgba(239,100,100,.22);border-radius:9px;color:#ffaaaa;background:rgba(239,100,100,.08)}.storage-remove:hover{background:rgba(239,100,100,.18)}
.storage-add{display:inline-flex;align-items:center;gap:7px;margin-top:11px;padding:9px 12px;border:1px dashed rgba(53,199,122,.38);border-radius:10px;color:#a7edc4;background:rgba(53,199,122,.06);font-size:11px;font-weight:700}.storage-add:hover{background:rgba(53,199,122,.12)}
.config-alert{display:flex;gap:10px;margin-bottom:14px;padding:12px;border-radius:11px;color:#e1c987;background:rgba(234,179,8,.07);border:1px solid rgba(234,179,8,.15);font-size:11px;line-height:1.8}
.advanced-gate{text-align:center;padding:24px 14px;border:1px dashed rgba(148,163,184,.22);border-radius:12px;background:rgba(255,255,255,.015)}.advanced-gate i{display:block;margin-bottom:10px;color:#e1c987;font-size:24px}.advanced-gate p{max-width:520px;margin:0 auto 14px;color:var(--super-muted);font-size:11px;line-height:1.9}.advanced-open{padding:9px 14px;border:1px solid rgba(234,179,8,.25);border-radius:10px;color:#f4daa0;background:rgba(234,179,8,.09);font-weight:700}
.advanced-editor{display:none}.advanced-editor.open{display:block}
.config-savebar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:17px;padding-top:14px;border-top:1px solid var(--super-border)}
.config-state{display:flex;align-items:center;gap:7px;color:var(--super-muted);font-size:11px}.config-state.valid{color:#8be3b2}.config-state.invalid{color:#ff9c9c}
.config-msg{font-size:11px;font-weight:700}
@media(max-width:600px){.settings-grid{grid-template-columns:1fr}.storage-row{grid-template-columns:1fr}.storage-remove{width:100%}.config-savebar{align-items:stretch;flex-direction:column}}
@media(max-width:900px){.super-grid{grid-template-columns:1fr}.super-pair-row{grid-template-columns:1fr}.super-stats{grid-template-columns:1fr 1fr}.super-intro{align-items:flex-start;flex-direction:column}}
@media(max-width:600px){.super-shell{padding:14px 12px 30px}.super-topbar{min-height:68px;padding:10px 12px;border-radius:14px}.super-brand-copy small{display:none}.super-intro{padding:17px}.super-intro h1{font-size:20px}.super-stats{grid-template-columns:1fr}.system-actions{grid-template-columns:1fr}.config-footer{align-items:stretch;flex-direction:column}.super-save{width:100%;justify-content:center}}

.instruction-list{display:flex;flex-direction:column;gap:10px}
.instruction-item{padding:13px;border:1px solid var(--super-border);border-radius:12px;background:rgba(255,255,255,.025)}
.instruction-item.archived{opacity:.58}.instruction-item-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.instruction-item h4{margin:0 0 5px;font-size:13px}.instruction-meta{display:flex;flex-wrap:wrap;gap:7px;color:var(--super-muted);font-size:10px}.instruction-text{margin:10px 0;color:#cbd5e1;font-size:11px;line-height:1.9;white-space:pre-wrap;max-height:90px;overflow:hidden}.instruction-actions{display:flex;gap:6px}.instruction-badge{padding:3px 7px;border-radius:999px;background:rgba(34,197,94,.1);color:#8be3b2}.instruction-badge.high{background:rgba(239,68,68,.1);color:#ff9c9c}.instruction-empty{padding:30px 12px;text-align:center;color:var(--super-muted)}
#instruction_modal .modal-content{background:#10202f;color:#e5edf5;border:1px solid rgba(148,163,184,.2);border-radius:16px}#instruction_modal .modal-header,#instruction_modal .modal-footer{border-color:rgba(148,163,184,.15)}#instruction_modal .form-control{background:#091521;color:#eef4f8;border:1px solid rgba(148,163,184,.25);border-radius:9px}#instruction_modal textarea{min-height:170px;resize:vertical}.target-users{max-height:160px;overflow:auto;padding:9px;border:1px solid rgba(148,163,184,.18);border-radius:9px;background:#091521}.target-users label{display:block;font-weight:400;padding:5px}

.instruction-file-field{padding:12px;border:1px dashed rgba(148,163,184,.25);border-radius:10px;background:rgba(255,255,255,.02)}
.instruction-file-field label{display:block}.instruction-file-field small,.instruction-file-field .help-block{color:var(--super-muted)}
.instruction-current-file{display:flex;align-items:center;gap:8px;margin-top:9px;padding:9px;border-radius:8px;background:#091521}.instruction-current-file label{margin-right:auto;margin-bottom:0;font-weight:400;color:#fca5a5}
.instruction-options{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px}.instruction-check{display:flex!important;align-items:center;gap:10px;margin:0!important;padding:11px 12px;border:1px solid rgba(148,163,184,.24);border-radius:10px;background:#091521;cursor:pointer;font-weight:600!important}.instruction-check input{appearance:auto!important;-webkit-appearance:checkbox!important;width:18px!important;height:18px!important;min-width:18px;opacity:1!important;position:static!important;margin:0!important;accent-color:#22c55e}.instruction-upload-progress{display:none;margin-top:10px}.instruction-upload-progress .progress{height:8px;margin:6px 0;background:#091521}.instruction-upload-progress .progress-bar{min-width:2%;transition:width .18s ease}.instruction-upload-status{font-size:11px;color:#a9bac8}.instruction-upload-cancel{float:left;color:#fca5a5;cursor:pointer}@media(max-width:700px){.instruction-options{grid-template-columns:1fr}}
.instruction-admin-file{margin-top:9px;padding:8px 10px;border-radius:8px;background:#091521;color:#9ed9bd;font-size:11px}

.software-update-card .super-card-body{display:flex;flex-direction:column;gap:14px}
.update-version-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.update-version-box{padding:13px;border:1px solid var(--super-border);border-radius:12px;background:#091521}
.update-version-box span{display:block;color:var(--super-muted);font-size:10px;margin-bottom:5px}.update-version-box strong{font-size:17px;color:#f8fafc;direction:ltr;display:inline-block}
.update-status{display:flex;align-items:center;gap:10px;padding:12px;border-radius:11px;background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.2);color:#bfdbfe}
.update-status.success{background:rgba(34,197,94,.08);border-color:rgba(34,197,94,.22);color:#bbf7d0}.update-status.warning{background:rgba(245,158,11,.08);border-color:rgba(245,158,11,.22);color:#fde68a}.update-status.danger{background:rgba(239,68,68,.08);border-color:rgba(239,68,68,.22);color:#fecaca}
.update-changelog{display:none;padding:12px;border:1px solid var(--super-border);border-radius:11px;background:rgba(255,255,255,.02)}.update-changelog h4{font-size:12px;margin:0 0 8px}.update-changelog ul{margin:0;padding-right:18px;color:#cbd5e1;font-size:11px;line-height:1.9}
.update-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.update-actions .btn{border-radius:9px}.update-source{font-size:9px;color:var(--super-muted);direction:ltr;word-break:break-all}.update-progress-wrap{display:none}.update-progress-track{height:9px;background:#07111c;border:1px solid var(--super-border);border-radius:99px;overflow:hidden}.update-progress-bar{height:100%;width:0;background:linear-gradient(90deg,#2563eb,#22c55e);transition:width .2s}.update-progress-text{font-size:10px;color:#cbd5e1;margin-top:6px;display:flex;justify-content:space-between;gap:10px}
