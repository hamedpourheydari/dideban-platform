<script><% include ../libs/js/material.min.js %></script>
<script><% include ../libs/js/pnotify.custom.min.js %></script>
<script><% include ../libs/js/moment.js %></script>
<script><% include ../libs/js/livestamp.min.js %></script>
<script><% include ../libs/js/placeholder.js %></script>
<script><% include ../libs/js/bootstrap.min.js %></script>
<script><% include ../libs/js/bootstrap-table.min.js %></script>
<script><% include ../libs/js/socket.io.js %></script>
<script>$user=<%-JSON.stringify($user)%></script>
<script>
$.ccio={accounts:{}};$.ls=localStorage;
if(!$user.lang||$user.lang==''){
    $user.lang="<%-config.language%>"
}
switch($user.lang){
    case'ar'://Arabic
    case'bn'://Bengali
        $('body').addClass('right-to-left')
        $('.mdl-menu__item').each(function(n,v){
            v=$(v).find('i')
            v.appendTo(v.parent())
        })
    break;
}
$.ccio.ws=io(location.origin);
$.ccio.cx=function(x){return $.ccio.ws.emit('super',x)}
$.ccio.ws.on('connect',function(d){
    $.ccio.cx({f:'init',mail:$user.mail,pass:$user.pass});
})
$.ccio.ws.on('f',function(d){
    switch(d.f){
        case'log':
            $.ccio.tm(4,d.log,'#logs table')
        break;
        case'save_configuration':
            $.conf.msg.html('تنظیمات ذخیره شد').css('color','#8be3b2');setConfigState(true,'تنظیمات ذخیره شد؛ برای اعمال کامل، سامانه را راه‌اندازی مجدد کنید')
        break;
        case'edit_account':
            d.msg='حساب کاربری ویرایش شد';
            $.each(d.form,function(n,v){
                $.ccio.accounts[d.ke][n]=v;
            });
        break;
        case'add_account':
            d.msg='حساب کاربری ایجاد شد';
            $.ccio.tm(0,d,'#accounts table')
            $('#accounts_count').text($('#accounts table tr').length)
            $.aN.selected=$.ccio.accounts[d.ke];
        break;
        case'delete_account':
            $('#accounts table tr[ke="'+d.ke+'"]').remove()
            $('#accounts_count').text($('#accounts table tr').length)
        break;
    }
    if(d.msg&&typeof d.msg==='string'){
        $('#toast')[0].MaterialSnackbar.showSnackbar({message:d.msg})
    }
})

$.ccio.tm=function(x,d,z,k){
    var tmp='';if(!d){d={}};if(!k){k={}};
    if(d.id&&!d.mid){d.mid=d.id;}
    switch(x){
        case 0://account row
            d.detailsJSON=JSON.parse(d.details);
            $.ccio.accounts[d.ke]=d;
            tmp+='<tr ke="'+d.ke+'"><td><b class="mail">'+d.mail+'</b></td><td>'+d.ke+'</td><td><a class="permission btn btn-xs btn-primary"><i class="fa fa-lock"></i></a></td><td><a class="delete btn btn-xs btn-danger"><i class="fa fa-trash-o"></i></a></td></tr>';
        break;
        case 4://log row, draw to global and monitor
            if(!d.time){d.time=$.ccio.init('t')}
            tmp+='<tr class="search-row"><td><span title="'+d.time+'" class="livestamp"></span><br><small>'+d.time+'</small><br><small>'+d.mid+'</small></td><td></td><td><pre class="pre-inline">'+$.ccio.init('jsontoblock',JSON.parse(d.info))+'</pre></td></tr>'
        break;
    }
    if(z){
        $(z).prepend(tmp)
        if(x===4){$('#logs .logs-empty').hide()}
    }
    switch(x){
        case 4:
            $.ccio.init('ls')
        break;
    }
    return tmp;
}
users=<%-JSON.stringify(users || []) || '[]'%>;
if(users){
    $.each(users,function(n,v){
        $.ccio.tm(0,v,'#accounts table')
    })
}
$.ccio.init=function(x,d,z,k){
    if(!k){k={}};k.tmp='';
    switch(x){
        case 'ls'://livestamp all
            g={e:jQuery('.livestamp')};
            g.e.each(function(){g.v=jQuery(this),g.t=g.v.attr('title');if(!g.t){return};g.v.toggleClass('livestamp livestamped').attr('title',$.ccio.init('t',g.t)).livestamp(g.t);})
            return g.e
        break;
        case't'://format time
            if(!d){d=new Date();}
            return moment(d).format('YYYY-MM-DD HH:mm:ss')
        break;
        case'jsontoblock'://draw json as block
            if(d instanceof Object){
                k.tmp+='<ul>'
                $.each(d,function(n,v){
                    k.tmp+='<li>';
                    k.tmp+='<b>'+n+'</b> : '+$.ccio.init('jsontoblock',v);
                    k.tmp+='</li>';
                })
                k.tmp+='</ul>'
            }else{
                k.tmp+='<span>';
                k.tmp+=d;
                k.tmp+='</span>';
            }
        break;
    }
    return k.tmp;
}
//logs
$.logs={e:$('#logs')}
$.logs.e.find('.delete').click(function(e){
    $.confirm.e.modal('show');
    $.confirm.title.html('حذف گزارش‌ها <small>'+e.u+'</small>')
    e.html='آیا از حذف این گزارش‌ها مطمئن هستید؟ گزارش‌های کاربران <b>حذف نخواهند شد</b>.'
    $.confirm.body.html(e.html)
    $.confirm.click({title:'حذف',class:'btn-danger'},function(){
        $.ccio.cx({f:'logs',ff:'delete',ke:'$'})
        $.logs.e.find('table').empty()
        $('#logs .logs-empty').show()
    });
})
//configuration manager
$.conf={
    e:$('#config_form'),
    msg:$('#config_form .config-msg'),
    state:$('#config_form .config-state'),
    draw:$('#conf_json [name="json"]'),
    data:<%-JSON.stringify(plainConfig)%>,
    valid:1,
    advancedOpen:false
};
function cloneConfig(obj){return JSON.parse(JSON.stringify(obj||{}))}
$.conf.data=cloneConfig($.conf.data)
function ensureObjects(){
    $.conf.data.db=$.conf.data.db||{}
    $.conf.data.mail=$.conf.data.mail||{}
    $.conf.data.mail.auth=$.conf.data.mail.auth||{}
    $.conf.data.addStorage=Array.isArray($.conf.data.addStorage)?$.conf.data.addStorage:[]
}
function setConfigState(valid,text){
    $.conf.valid=valid?1:0
    $.conf.state.toggleClass('valid',!!valid).toggleClass('invalid',!valid)
    $.conf.state.html('<i class="fa '+(valid?'fa-check-circle':'fa-exclamation-circle')+'"></i> '+text)
}
function escapeAttr(value){return String(value==null?'':value).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function drawStorage(){
    ensureObjects()
    var html=''
    $.each($.conf.data.addStorage,function(index,item){
        item=item||{}
        html+='<div class="storage-row" data-index="'+index+'">'
        html+='<div class="setting-field"><label>نام</label><input class="setting-input storage-name" type="text" value="'+escapeAttr(item.name||'')+'" placeholder="archive"></div>'
        html+='<div class="setting-field"><label>مسیر</label><input class="setting-input storage-path" type="text" dir="ltr" value="'+escapeAttr(item.path||'')+'" placeholder="D:/Dideban/Archive"></div>'
        html+='<button type="button" class="storage-remove" title="حذف"><i class="fa fa-trash-o"></i></button></div>'
    })
    if(!html)html='<div class="logs-empty" style="padding:28px 12px"><i class="fa fa-hdd-o fa-2x"></i><br><br>محل ذخیره‌سازی تکمیلی تعریف نشده است.</div>'
    $('#storage_list').html(html)
}
function drawStandardForm(){
    ensureObjects()
    $('#cfg_port').val($.conf.data.port||8080)
    $('#cfg_language').val($.conf.data.language||'fa')
    $('#cfg_videos_dir').val($.conf.data.videosDir||'')
    $('#cfg_db_host').val($.conf.data.db.host||'')
    $('#cfg_db_port').val($.conf.data.db.port||3306)
    $('#cfg_db_name').val($.conf.data.db.database||'')
    $('#cfg_db_user').val($.conf.data.db.user||'')
    $('#cfg_db_password').val($.conf.data.db.password||'')
    $('#cfg_mail_service').val($.conf.data.mail.service||'')
    $('#cfg_mail_user').val($.conf.data.mail.auth.user||'')
    $('#cfg_mail_password').val($.conf.data.mail.auth.pass||'')
    drawStorage()
}
function collectStandardForm(){
    ensureObjects()
    $.conf.data.port=parseInt($('#cfg_port').val(),10)||8080
    $.conf.data.language=$('#cfg_language').val()||'fa'
    $.conf.data.videosDir=$('#cfg_videos_dir').val().trim()
    $.conf.data.db.host=$('#cfg_db_host').val().trim()
    $.conf.data.db.port=parseInt($('#cfg_db_port').val(),10)||3306
    $.conf.data.db.database=$('#cfg_db_name').val().trim()
    $.conf.data.db.user=$('#cfg_db_user').val().trim()
    $.conf.data.db.password=$('#cfg_db_password').val()
    $.conf.data.mail.service=$('#cfg_mail_service').val().trim()
    $.conf.data.mail.auth.user=$('#cfg_mail_user').val().trim()
    $.conf.data.mail.auth.pass=$('#cfg_mail_password').val()
    var storage=[]
    $('#storage_list .storage-row').each(function(){
        var name=$(this).find('.storage-name').val().trim()
        var path=$(this).find('.storage-path').val().trim()
        if(name||path)storage.push({name:name,path:path})
    })
    $.conf.data.addStorage=storage
    return $.conf.data
}
function syncAdvancedEditor(){
    $.conf.draw.val(JSON.stringify(collectStandardForm(),null,3))
    setConfigState(true,'ساختار JSON معتبر است')
}
drawStandardForm()
$.conf.draw.val(JSON.stringify($.conf.data,null,3))
$('.config-tab').click(function(){
    var pane=$(this).attr('data-pane')
    $('.config-tab').removeClass('active');$(this).addClass('active')
    $('.config-pane').removeClass('active');$('.config-pane[data-pane="'+pane+'"]').addClass('active')
    if(pane==='advanced'&&$.conf.advancedOpen)syncAdvancedEditor()
})
$('.password-toggle').click(function(){
    var input=$(this).siblings('input')
    var show=input.attr('type')==='password'
    input.attr('type',show?'text':'password')
    $(this).find('i').toggleClass('fa-eye',!show).toggleClass('fa-eye-slash',show)
})
$('#storage_add').click(function(){collectStandardForm();$.conf.data.addStorage.push({name:'',path:''});drawStorage()})
$('#storage_list').on('click','.storage-remove',function(){
    collectStandardForm();var index=parseInt($(this).closest('.storage-row').attr('data-index'),10);$.conf.data.addStorage.splice(index,1);drawStorage()
})
$('.advanced-open').click(function(){
    var openEditor=function(){
        $.conf.advancedOpen=true
        $('.advanced-gate').hide();$('.advanced-editor').addClass('open')
        syncAdvancedEditor();$.conf.draw.focus()
    }
    $.confirm.e.modal('show')
    $.confirm.title.html('فعال‌سازی ویرایشگر پیشرفته')
    $.confirm.body.html('<p>ویرایش مستقیم JSON می‌تواند باعث توقف سامانه شود. فقط در صورتی ادامه دهید که با ساختار فایل <b>conf.json</b> آشنا هستید.</p>')
    $.confirm.click({title:'ادامه می‌دهم',class:'btn-warning'},openEditor)
})
$.conf.draw.on('input',function(){
    try{
        $.parseJSON($.conf.draw.val());setConfigState(true,'ساختار JSON معتبر است')
    }catch(er){setConfigState(false,'ساختار JSON معتبر نیست')}
})
$.conf.e.submit(function(e){
    e.preventDefault()
    var data
    if($.conf.advancedOpen&&$('.config-pane[data-pane="advanced"]').hasClass('active')){
        try{data=$.parseJSON($.conf.draw.val());setConfigState(true,'ساختار JSON معتبر است')}catch(er){setConfigState(false,'JSON نامعتبر است و ذخیره نشد');return false}
    }else{
        data=collectStandardForm()
        if(!data.videosDir||!data.db.host||!data.db.database||!data.db.user){
            setConfigState(false,'فیلدهای ضروری را کامل کنید');return false
        }
    }
    $.confirm.e.modal('show')
    $.confirm.title.html('ذخیره تنظیمات سامانه')
    $.confirm.body.html('<p>تغییرات در فایل <b>conf.json</b> ذخیره می‌شود. برای اعمال برخی تنظیمات، راه‌اندازی مجدد دیده‌بان ضروری است.</p>')
    $.confirm.click({title:'ذخیره',class:'btn-success'},function(){
        $.conf.data=cloneConfig(data)
        $.ccio.cx({f:'system',ff:'configure',data:data})
    })
    return false
})
//sys controls
$.system={e:$('#system')}
$.system.e.find('[system]').click(function(e){
    switch($(this).attr('system')){
        case'update':
            e.distro=$(this).attr('distro')
            if(!e.distro){e.distro='master'}
            $.confirm.e.modal('show')
            $.confirm.title.html('دیده‌بان به‌روزرسانی شود؟')
            $.confirm.body.html('به‌روزرسانی دیده‌بان باعث بازنویسی فایل‌ها می‌شود. اگر فایل‌ها را شخصاً تغییر داده‌اید، باید دیده‌بان را به‌صورت دستی به‌روزرسانی کنید. به‌روزرسان، آخرین نسخه ' + e.distro + ' را از مخزن رسمی پروژه دریافت خواهد کرد.')
            $.confirm.click({title:'به‌روزرسانی',class:'btn-danger'},function(){
                $.ccio.cx({f:'system',ff:'update',distro:e.distro})
            });
        break;
    }
})
$.system.e.find('[restart]').click(function(e){
    $.confirm.e.modal('show');
    e.html=''
    e.title=''
    e.target=$(this).attr('restart').split(',')
    e.target.forEach(function(v){
        switch(v){
            case'system':
                e.html+='<p>آیا می‌خواهید هسته اصلی (camera.js) مجدداً راه‌اندازی شود؟ افزونه‌ها مجدداً راه‌اندازی نخواهند شد و پس از در دسترس قرار گرفتن دوباره دیده‌بان، مجدداً متصل خواهند شد.</p>'
            break;
            case'cron':
                e.html+='<p>آیا می‌خواهید سرویس زمان‌بندی CRON ‏(cron.js) مجدداً راه‌اندازی شود؟</p>'
            break;
            case'logs':
                e.html+='<p>گزارش‌های کنسول PM2 پاک شوند؟ گزارش‌های ذخیره‌شده در پایگاه داده <b>حذف نخواهند شد</b>.</p>'
            break;
        }
    })
    $.confirm.title.html('راه‌اندازی مجدد؟')
    $.confirm.body.html(e.html)
    $.confirm.click({title:'راه‌اندازی مجدد',class:'btn-danger'},function(){
        $.ccio.cx({f:'system',ff:'restart',target:e.target})
    });
})
$(document).ready(function(){
   /*
    $.each(<%-JSON.stringify(Logs)%>,function(n,v){
        $.ccio.tm(4,v,'#logs table')
    })
    */
})
    //
$('body')
.on('click','.logout',function(e){
    localStorage.removeItem('ShinobiLogin_'+location.host);location.href='/';
})    
</script>

