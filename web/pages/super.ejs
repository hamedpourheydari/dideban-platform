<div class="modal fade" id="instruction_modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document"><div class="modal-content">
    <div class="modal-header"><button type="button" class="close" data-dismiss="modal" style="color:#fff">&times;</button><h4 class="modal-title"><i class="fa fa-bullhorn"></i> مدیریت دستورالعمل</h4></div>
    <div class="modal-body">
      <form id="instruction_form">
        <input type="hidden" name="id">
        <div class="form-group"><label>عنوان</label><input class="form-control" name="title" maxlength="255" required></div>
        <div class="form-group"><label>متن دستورالعمل</label><textarea class="form-control" name="body" maxlength="20000" required></textarea></div>
        <div class="form-group instruction-file-field">
          <label><i class="fa fa-paperclip"></i> فایل پیوست <small>(اختیاری، حداکثر ۱۰ مگابایت)</small></label>
          <input type="file" class="form-control" name="attachment" accept=".pdf,.png,.jpg,.jpeg,.webp,.txt,.doc,.docx,.xls,.xlsx,.zip">
          <div class="instruction-current-file" style="display:none"><i class="fa fa-file-o"></i> <span></span> <a class="instruction-current-download btn btn-xs btn-info" target="_blank" rel="noopener" download><i class="fa fa-download"></i> دانلود فایل فعلی</a><label><input type="checkbox" name="remove_attachment"> حذف فایل فعلی</label></div>
          <p class="help-block">فرمت‌های مجاز: PDF، تصویر، متن، Word، Excel و ZIP</p><div class="instruction-upload-progress"><div class="instruction-upload-status">آماده بارگذاری</div><div class="progress"><div class="progress-bar progress-bar-success" style="width:0%"></div></div><a class="instruction-upload-cancel">لغو بارگذاری</a><div style="clear:both"></div></div>
        </div>
        <div class="row">
          <div class="col-sm-4"><div class="form-group"><label>اهمیت</label><select class="form-control" name="priority"><option value="normal">عادی</option><option value="high">مهم</option></select></div></div>
          <div class="col-sm-4"><div class="form-group"><label>مخاطب</label><select class="form-control" name="target_type"><option value="all">همه کاربران</option><option value="group">یک مجموعه (Key)</option><option value="users">کاربران انتخابی</option></select></div></div>
          <div class="col-sm-4 target-group-wrap" style="display:none"><div class="form-group"><label>شناسه مجموعه</label><select class="form-control" name="target_group"></select></div></div>
        </div>
        <div class="form-group target-users-wrap" style="display:none"><label>انتخاب کاربران</label><div class="target-users"></div></div>
        <div class="instruction-options">
          <label class="instruction-check"><input type="checkbox" name="pinned"><span><i class="fa fa-thumb-tack"></i> سنجاق‌شده نمایش داده شود</span></label>
          <label class="instruction-check"><input type="checkbox" name="require_ack"><span><i class="fa fa-check-square-o"></i> تأیید «مطالعه و درک کردم» الزامی باشد</span></label>
        </div>
      </form>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-default" data-dismiss="modal">انصراف</button><button type="button" class="btn btn-success instruction-save"><i class="fa fa-check"></i> ذخیره و انتشار</button></div>
  </div></div>
</div>

