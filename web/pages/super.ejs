<script><% include ../libs/js/material.min.js %></script>
<script><% include ../libs/js/pnotify.custom.min.js %></script>
<script><% include ../libs/js/moment.js %></script>
<script><% include ../libs/js/livestamp.min.js %></script>
<script><% include ../libs/js/placeholder.js %></script>
<script><% include ../libs/js/bootstrap.min.js %></script>
<script><% include ../libs/js/bootstrap-table.min.js %></script>
<script><% include ../libs/js/socket.io.js %></script>
<script>$user=<%-JSON.stringify($user)%></script>
<script>
$.ccio={accounts:{}};$.ls=localStorage;
if(!$user.lang||$user.lang==''){
    $user.lang="<%-config.language%>"
}
switch($user.lang){
    case'ar'://Arabic
    case'bn'://Bengali
        $('body').addClass('right-to-left')
        $('.mdl-menu__item').each(function(n,v){
            v=$(v).find('i')
            v.appendTo(v.parent())
        })
    break;
}
$.ccio.ws=io(location.origin);
$.ccio.cx=function(x){return $.ccio.ws.emit('super',x)}
$.ccio.ws.on('connect',function(d){
    $.ccio.cx({f:'init',mail:$user.mail,pass:$user.pass});
})
$.ccio.ws.on('f',function(d){
    switch(d.f){
        case'init_success':
            $.ccio.cx({f:'instructions',ff:'list'})
            $.ccio.cx({f:'software_update',ff:'status'})
        break;
        case'log':
            $.ccio.tm(4,d.log,'#logs table')
        break;
        case'save_configuration':
            $.conf.msg.html('تنظیمات ذخیره شد').css('color','#8be3b2');setConfigState(true,'تنظیمات ذخیره شد؛ برای اعمال کامل، سامانه را راه‌اندازی مجدد کنید')
        break;
        case'support_health_result':
            $.supportCenter.renderHealth(d)
        break;
        case'support_package_progress':
            $.supportCenter.progress(d.message)
        break;
        case'support_package_ready':
            $.supportCenter.packageReady(d)
        break;
        case'support_center_error':
            $.supportCenter.error(d.msg||'عملیات مرکز پشتیبانی ناموفق بود.')
        break;
        case'software_update_status':
            $.softwareUpdate.render(d)
        break;
        case'software_update_error':
            if($.softwareUpdate&&$.softwareUpdate.finishRollbackRequest)$.softwareUpdate.finishRollbackRequest()
            $.softwareUpdate.error(d.msg||'عملیات به‌روزرسانی انجام نشد.')
        break;
        case'software_update_progress':
            $.softwareUpdate.progress(d)
        break;
        case'software_update_downloaded':
            $.softwareUpdate.downloaded(d)
        break;
        case'software_update_installing':
            $.softwareUpdate.installing(d)
        break;
        case'software_update_offline_upload_ready':
            $.softwareUpdate.uploadOffline(d)
        break;
        case'software_update_offline_ready':
            $.softwareUpdate.offlineReady(d)
        break;
        case'software_update_backups':
            $.softwareUpdate.showBackups(d.backups||[])
        break;
        case'instructions_list':
            $.instructions.draw(d.instructions||[])
        break;
        case'instruction_attachment_upload_ready':
            $.instructions.uploadState.token=d.token
            $.instructions.sendNextChunk()
        break;
        case'instruction_attachment_chunk_saved':
            if(!$.instructions.uploadState||$.instructions.uploadState.cancelled)return
            $.instructions.uploadState.index++
            $.instructions.updateUploadProgress()
            $.instructions.sendNextChunk()
        break;
        case'instruction_attachment_uploaded':
            var pending=$.instructions.uploadState.pendingSubmit
            $.instructions.finishUploadUi()
            $.instructions.uploadState={}
            if(pending)pending({upload_token:d.token})
        break;
        case'instruction_saved':
            // The file and instruction are already persisted when this event arrives.
            // Reset the busy state before closing the modal so the form does not stay
            // forever on "uploading/saving" when it is opened again.
            var completedState=$.instructions.uploadState||{}
            if(completedState.timer)clearTimeout(completedState.timer)
            $.instructions.uploadState={}
            $('#instruction_form .instruction-upload-progress').show()
            $('#instruction_form .instruction-upload-progress .progress-bar').css('width','100%')
            $('#instruction_form .instruction-upload-status').text('فایل و دستورالعمل با موفقیت ذخیره شد.')
            $.instructions.uploadButton().prop('disabled',false).html('<i class="fa fa-check"></i> ذخیره و انتشار')
            new PNotify({title:'موفق',text:d.msg||'دستورالعمل با موفقیت ذخیره شد.',type:'success'})
            $.ccio.cx({f:'instructions',ff:'list'})
            setTimeout(function(){
                $('#instruction_modal').modal('hide')
                $('#instruction_form .instruction-upload-progress').hide().find('.progress-bar').css('width','0%')
                $('#instruction_form .instruction-upload-status').text('آماده بارگذاری')
            },350)
        break;
        case'instruction_deleted':
            $.ccio.cx({f:'instructions',ff:'list'})
        break;
        case'instructions_error':
            d.msg=d.msg||'خطا در مدیریت دستورالعمل‌ها'
            $.instructions.abortUpload(d.msg)
        break;
        case'edit_account':
            d.msg='حساب کاربری ویرایش شد';
            $.each(d.form,function(n,v){
                $.ccio.accounts[d.ke][n]=v;
            });
        break;
        case'add_account':
            d.msg='حساب کاربری ایجاد شد';
            $.ccio.tm(0,d,'#accounts table')
            $('#accounts_count').text($('#accounts table tr').length)
            $.aN.selected=$.ccio.accounts[d.ke];
        break;
        case'delete_account':
            $('#accounts table tr[ke="'+d.ke+'"]').remove()
            $('#accounts_count').text($('#accounts table tr').length)
        break;
    }
    if(d.msg&&typeof d.msg==='string'){
        $('#toast')[0].MaterialSnackbar.showSnackbar({message:d.msg})
    }
})

$.ccio.tm=function(x,d,z,k){
    var tmp='';if(!d){d={}};if(!k){k={}};
    if(d.id&&!d.mid){d.mid=d.id;}
    switch(x){
        case 0://account row
            d.detailsJSON=JSON.parse(d.details);
            $.ccio.accounts[d.ke]=d;
            tmp+='<tr ke="'+d.ke+'"><td><b class="mail">'+d.mail+'</b></td><td>'+d.ke+'</td><td><a class="permission btn btn-xs btn-primary"><i class="fa fa-lock"></i></a></td><td><a class="delete btn btn-xs btn-danger"><i class="fa fa-trash-o"></i></a></td></tr>';
        break;
        case 4://log row, draw to global and monitor
            if(!d.time){d.time=$.ccio.init('t')}
            tmp+='<tr class="search-row"><td><span title="'+d.time+'" class="livestamp"></span><br><small>'+d.time+'</small><br><small>'+d.mid+'</small></td><td></td><td><pre class="pre-inline">'+$.ccio.init('jsontoblock',JSON.parse(d.info))+'</pre></td></tr>'
        break;
    }
    if(z){
        $(z).prepend(tmp)
        if(x===4){$('#logs .logs-empty').hide()}
    }
    switch(x){
        case 4:
            $.ccio.init('ls')
        break;
    }
    return tmp;
}
users=<%-JSON.stringify(users || []) || '[]'%>;
if(users){
    $.each(users,function(n,v){
        $.ccio.tm(0,v,'#accounts table')
    })
}

$.instructions={e:$('#instructions_admin'),rows:{}}
$.instructions.escape=function(v){return $('<div>').text(v==null?'':v).html()}
$.instructions.draw=function(rows){
    $.instructions.rows={}
    var html=''
    $.each(rows,function(_,row){
        $.instructions.rows[row.id]=row
        var target=row.target_type==='all'?'همه کاربران':(row.target_type==='group'?'مجموعه '+$.instructions.escape(row.target_value):'کاربران انتخابی')
        html+='<article class="instruction-item '+(row.status==='archived'?'archived':'')+'" data-id="'+row.id+'">'
        html+='<div class="instruction-item-head"><div><h4>'+(row.pinned?'<i class="fa fa-thumb-tack"></i> ':'')+$.instructions.escape(row.title)+'</h4><div class="instruction-meta"><span class="instruction-badge '+(row.priority==='high'?'high':'')+'">'+(row.priority==='high'?'مهم':'عادی')+'</span><span>'+target+'</span><span>'+$.instructions.escape(row.status==='active'?'فعال':'بایگانی')+'</span><span>مطالعه: '+(row.read_count||0)+'</span><span>تأیید: '+(row.ack_count||0)+'</span></div></div>'
        html+='<div class="instruction-actions"><button class="btn btn-xs btn-primary instruction-edit"><i class="fa fa-pencil"></i></button>'
        if(row.status==='active')html+='<button class="btn btn-xs btn-warning instruction-archive"><i class="fa fa-archive"></i></button>'
        html+='<button class="btn btn-xs btn-danger instruction-delete"><i class="fa fa-trash-o"></i></button></div></div>'
        html+='<div class="instruction-text">'+$.instructions.escape(row.body)+'</div>'
        if(row.has_attachment||row.attachment_url||row.attachment_path||row.attachment_name){
            var adminAttachmentUrl=row.attachment_url||('/dideban/instruction-attachment-by-id/'+encodeURIComponent(String(row.id||'')))
            html+='<div class="instruction-admin-attachment-wrap"><span class="instruction-attachment-label"><i class="fa fa-paperclip"></i> دارای فایل پیوست</span><a class="instruction-admin-file" href="'+$.instructions.escape(adminAttachmentUrl)+'" target="_blank" rel="noopener" download><span>'+$.instructions.escape(row.attachment_name||'دانلود فایل پیوست')+' <small>'+(row.attachment_size?'('+(Math.max(1,Math.round(Number(row.attachment_size)/1024)))+' KB)':'')+'</small></span><span class="dideban-download-label"><i class="fa fa-download"></i> دانلود فایل</span></a></div>'
        }
        html+='</article>'
    })
    $.instructions.e.find('.instruction-list').html(html||'<div class="instruction-empty"><i class="fa fa-inbox fa-2x"></i><br><br>هنوز دستورالعملی منتشر نشده است.</div>')
}
$.instructions.fillTargets=function(){
    var groups={},groupHtml='',usersHtml=''
    $.each(users||[],function(_,u){
        groups[u.ke]=1
        usersHtml+='<label><input type="checkbox" value="'+$.instructions.escape(u.ke+':'+u.uid)+'"> '+$.instructions.escape(u.mail)+' <small>('+$.instructions.escape(u.ke)+')</small></label>'
    })
    $.each(groups,function(ke){groupHtml+='<option value="'+$.instructions.escape(ke)+'">'+$.instructions.escape(ke)+'</option>'})
    $('#instruction_form [name="target_group"]').html(groupHtml)
    $('#instruction_form .target-users').html(usersHtml||'<small>کاربری وجود ندارد.</small>')
}
$.instructions.open=function(row){
    row=row||{}
    var f=$('#instruction_form')[0];f.reset()
    $('#instruction_form [name="id"]').val(row.id||'')
    $('#instruction_form [name="title"]').val(row.title||'')
    $('#instruction_form [name="body"]').val(row.body||'')
    $('#instruction_form [name="priority"]').val(row.priority||'normal')
    $('#instruction_form [name="target_type"]').val(row.target_type||'all').trigger('change')
    $('#instruction_form [name="pinned"]').prop('checked',String(row.pinned)==='1')
    $('#instruction_form [name="require_ack"]').prop('checked',String(row.require_ack)==='1')
    if(row.target_type==='group')$('#instruction_form [name="target_group"]').val(row.target_value||'')
    $('#instruction_form [name="attachment"]').val('')
    $('#instruction_form [name="remove_attachment"]').prop('checked',false)
    if(row.has_attachment||row.attachment_url||row.attachment_path||row.attachment_name){
        var currentUrl=row.attachment_url||('/dideban/instruction-attachment-by-id/'+encodeURIComponent(String(row.id||'')))
        $('#instruction_form .instruction-current-file').show().find('span').text(row.attachment_name||'فایل پیوست')
        $('#instruction_form .instruction-current-download').attr('href',currentUrl)
    }else $('#instruction_form .instruction-current-file').hide()
    if(row.target_type==='users'){
        var selected=[];try{selected=JSON.parse(row.target_value||'[]')}catch(e){}
        $('#instruction_form .target-users input').each(function(){$(this).prop('checked',selected.indexOf($(this).val())>-1)})
    }
    $('#instruction_modal').modal('show')
}
$.instructions.fillTargets()
$('#instruction_form [name="target_type"]').change(function(){
    var value=$(this).val();$('.target-group-wrap').toggle(value==='group');$('.target-users-wrap').toggle(value==='users')
})
$.instructions.e.on('click','.instruction-add',function(){$.instructions.open()})
$.instructions.e.on('click','.instruction-edit',function(){$.instructions.open($.instructions.rows[$(this).closest('.instruction-item').data('id')])})
$.instructions.e.on('click','.instruction-archive',function(){var id=$(this).closest('.instruction-item').data('id');$.ccio.cx({f:'instructions',ff:'archive',id:id})})
$.instructions.e.on('click','.instruction-delete',function(){
    var id=$(this).closest('.instruction-item').data('id')
    $.confirm.e.modal('show');$.confirm.title.html('حذف دائمی دستورالعمل');$.confirm.body.html('این دستورالعمل و تمام سوابق مطالعه آن حذف می‌شود.')
    $.confirm.click({title:'حذف',class:'btn-danger'},function(){$.ccio.cx({f:'instructions',ff:'delete',id:id})})
})
$.instructions.uploadState={}
$.instructions.uploadButton=function(){return $('.instruction-save')}
$.instructions.updateUploadProgress=function(){
    var state=$.instructions.uploadState||{},total=state.chunks?state.chunks.length:0,current=Math.min(state.index||0,total)
    var percent=total?Math.round((current/total)*100):0
    $('#instruction_form .instruction-upload-progress').show().find('.progress-bar').css('width',percent+'%')
    $('#instruction_form .instruction-upload-status').text(total?'در حال بارگذاری فایل: '+percent+'٪ ('+current+' از '+total+' بخش)':'در حال آماده‌سازی فایل...')
}
$.instructions.finishUploadUi=function(){
    $('#instruction_form .instruction-upload-progress').hide().find('.progress-bar').css('width','0%')
    $.instructions.uploadButton().prop('disabled',false).html('<i class="fa fa-check"></i> ذخیره و انتشار')
}
$.instructions.abortUpload=function(message){
    var state=$.instructions.uploadState||{}
    if(state.timer)clearTimeout(state.timer)
    state.cancelled=true
    $.instructions.uploadState={}
    $.instructions.finishUploadUi()
    if(message)new PNotify({title:'خطا',text:message,type:'error'})
}
$.instructions.armUploadTimeout=function(){
    var state=$.instructions.uploadState
    if(state.timer)clearTimeout(state.timer)
    state.timer=setTimeout(function(){$.instructions.abortUpload('بارگذاری فایل متوقف شد. اتصال شبکه یا محدودیت WebSocket را بررسی کنید.')},20000)
}
$.instructions.sendNextChunk=function(){
    var state=$.instructions.uploadState
    if(!state||state.cancelled||!state.token)return
    if(state.timer)clearTimeout(state.timer)
    if(state.index>=state.chunks.length){
        $('#instruction_form .instruction-upload-status').text('در حال نهایی‌سازی فایل...')
        $.ccio.cx({f:'instructions',ff:'upload_finish',token:state.token})
        $.instructions.armUploadTimeout()
        return
    }
    $.ccio.cx({f:'instructions',ff:'upload_chunk',token:state.token,index:state.index,total:state.chunks.length,chunk:state.chunks[state.index]})
    $.instructions.armUploadTimeout()
}
$('#instruction_form').on('click','.instruction-upload-cancel',function(){
    var token=$.instructions.uploadState&&$.instructions.uploadState.token
    if(token)$.ccio.cx({f:'instructions',ff:'upload_cancel',token:token})
    $.instructions.abortUpload('بارگذاری فایل لغو شد.')
})
$('.instruction-save').click(function(){
    var button=$(this),fileInput=$('#instruction_form [name="attachment"]')[0],file=fileInput&&fileInput.files&&fileInput.files[0]
    var submit=function(attachment){
        var type=$('#instruction_form [name="target_type"]').val(),target=''
        if(type==='group')target=$('#instruction_form [name="target_group"]').val()||''
        if(type==='users')target=JSON.stringify($('#instruction_form .target-users input:checked').map(function(){return $(this).val()}).get())
        button.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> در حال ذخیره...')
        $.ccio.cx({f:'instructions',ff:'save',form:{
            id:$('#instruction_form [name="id"]').val(),title:$('#instruction_form [name="title"]').val(),body:$('#instruction_form [name="body"]').val(),priority:$('#instruction_form [name="priority"]').val(),target_type:type,target_value:target,pinned:$('#instruction_form [name="pinned"]').is(':checked'),require_ack:$('#instruction_form [name="require_ack"]').is(':checked'),status:'active',attachment:attachment||{remove:$('#instruction_form [name="remove_attachment"]').is(':checked')}
        }})
    }
    if(file){
        if(file.size>10*1024*1024){new PNotify({title:'خطا',text:'حداکثر حجم فایل ۱۰ مگابایت است.',type:'error'});return}
        button.prop('disabled',true).html('<i class="fa fa-spinner fa-spin"></i> در حال بارگذاری فایل...')
        $('#instruction_form .instruction-upload-progress').show()
        $('#instruction_form .instruction-upload-status').text('در حال خواندن فایل...')
        var reader=new FileReader()
        reader.onload=function(){
            var data=String(reader.result||''),comma=data.indexOf(',')
            if(comma<0){$.instructions.abortUpload('خواندن فایل ممکن نشد.');return}
            // Socket.IO on the server accepts up to 20 MB. Sending the Data URL in the
            // normal save request is substantially more reliable than the previous
            // per-chunk acknowledgement flow and also works for very small files.
            $('#instruction_form .instruction-upload-progress').show().find('.progress-bar').css('width','100%')
            $('#instruction_form .instruction-upload-status').text('فایل خوانده شد؛ در حال ذخیره روی سرور...')
            $.instructions.uploadState={cancelled:false}
            submit({name:file.name,mime:file.type||'application/octet-stream',size:file.size,data:data})
        }
        reader.onerror=function(){$.instructions.abortUpload('خواندن فایل ممکن نشد.')}
