/* Phase 30.6 — Professional Super Dashboard visual refresh (UI only) */
:root{
    --super-bg:#06101a;
    --super-panel:#111e2c;
    --super-panel-2:#172637;
    --super-panel-3:#0b1723;
    --super-border:rgba(148,163,184,.16);
    --super-border-strong:rgba(148,163,184,.27);
    --super-text:#edf4fb;
    --super-muted:#91a4b8;
    --super-green:#39d083;
    --super-green-dark:#219a5a;
    --super-blue:#55a9ff;
    --super-amber:#e8b34f;
    --super-red:#ef6f75;
    --super-shadow:0 18px 48px rgba(0,0,0,.24);
    --super-shadow-soft:0 8px 24px rgba(0,0,0,.16);
}
body.super-page{
    background:
        radial-gradient(circle at 12% 0%,rgba(57,208,131,.10),transparent 27%),
        radial-gradient(circle at 92% 100%,rgba(85,169,255,.08),transparent 28%),
        linear-gradient(145deg,#06101a 0%,#091522 48%,#07121d 100%);
}
body.super-page:before{opacity:.16;background-size:28px 28px}
.super-shell{max-width:1400px;padding:24px 28px 56px}
.super-topbar{
    min-height:72px;
    margin-bottom:16px;
    padding:11px 16px;
    border-radius:16px;
    background:rgba(13,25,38,.88);
    box-shadow:var(--super-shadow-soft);
}
.super-brand-logo{width:44px;height:44px;border-radius:13px}
.super-brand-copy strong{font-size:17px;letter-spacing:-.2px}
.super-menu .dropdown-toggle{width:40px;height:40px}
.super-intro{
    position:relative;
    overflow:hidden;
    margin-bottom:16px;
    padding:20px 22px;
    border-radius:16px;
    background:linear-gradient(120deg,rgba(57,208,131,.13),rgba(85,169,255,.055));
    box-shadow:var(--super-shadow-soft);
}
.super-intro:after{
    content:"";
    position:absolute;
    left:-40px;
    top:-70px;
    width:210px;
    height:210px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(85,169,255,.12),transparent 67%);
    pointer-events:none;
}
.super-intro h1{font-size:22px;letter-spacing:-.4px}
.super-status{position:relative;z-index:1;padding:8px 12px}
.super-stats{gap:12px;margin-bottom:16px}
.super-stat{
    min-height:82px;
    padding:14px 16px;
    border-radius:14px;
    background:linear-gradient(145deg,rgba(18,32,47,.96),rgba(12,24,36,.96));
    box-shadow:var(--super-shadow-soft);
    transition:transform .18s ease,border-color .18s ease,background .18s ease;
}
.super-stat:hover{transform:translateY(-2px);border-color:rgba(57,208,131,.28);background:linear-gradient(145deg,rgba(21,38,54,.98),rgba(13,27,40,.98))}
.super-stat-icon{width:40px;height:40px;border-radius:11px}
.super-stat strong{font-size:18px}
.super-grid{grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:16px}
.super-column{gap:16px}
.super-card{
    border-radius:16px;
    background:linear-gradient(180deg,rgba(18,32,47,.97),rgba(14,27,40,.97));
    box-shadow:var(--super-shadow-soft);
    transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease;
}
.super-card:hover{border-color:rgba(148,163,184,.23);box-shadow:0 14px 38px rgba(0,0,0,.22)}
.super-card-header{min-height:70px;padding:14px 16px;background:linear-gradient(180deg,rgba(255,255,255,.025),rgba(255,255,255,.008))}
.super-card-title{font-size:14px;letter-spacing:-.15px}
.super-card-title .icon{width:32px;height:32px;border-radius:9px;box-shadow:inset 0 0 0 1px rgba(57,208,131,.08)}
.super-card-subtitle{margin-top:3px;font-size:10.5px;line-height:1.65}
.super-card-body{padding:14px 16px 16px}
.super-action{width:32px;height:32px;border-radius:9px}
.super-table-wrap{min-height:84px}
.super-page .table>tbody>tr>td{padding:11px 8px}
.super-page .table>tbody>tr{transition:background .16s ease}
.super-page .table>tbody>tr:hover{background:rgba(255,255,255,.025)}
.super-page .btn{
    border-radius:9px!important;
    border:1px solid transparent;
    font-weight:700;
    box-shadow:none;
    transition:transform .16s ease,filter .16s ease,box-shadow .16s ease;
}
.super-page .btn:hover{transform:translateY(-1px);filter:brightness(1.05)}
.super-page .btn:active{transform:translateY(0)}
.super-page .btn-primary{border-color:rgba(85,169,255,.26);background:linear-gradient(180deg,#428fd6,#327cbc)}
.super-page .btn-success{border-color:rgba(57,208,131,.25);background:linear-gradient(180deg,#35c77a,#23995b)}
.super-page .btn-warning{border-color:rgba(232,179,79,.25);background:linear-gradient(180deg,#e8b34f,#c99131);color:#17202a}
.super-page .btn-danger{border-color:rgba(239,111,117,.25);background:linear-gradient(180deg,#e8646b,#c94c55)}
.logs-body{height:360px;padding:8px 12px 12px}
#logs .table{border-collapse:separate;border-spacing:0 9px}
#logs .table>tbody>tr{background:rgba(7,17,28,.66);box-shadow:inset 0 0 0 1px rgba(148,163,184,.10)}
#logs .table>tbody>tr>td{padding:12px 13px;border:0!important;line-height:1.75}
#logs .table>tbody>tr>td:first-child{border-radius:0 11px 11px 0}
#logs .table>tbody>tr>td:last-child{border-radius:11px 0 0 11px}
#logs .table pre,#logs .table code{white-space:pre-wrap;word-break:break-word;color:#c8d6e5;background:transparent;border:0;font-size:11px}
.logs-empty{padding:44px 18px}
.config-card .super-card-body{padding:15px 16px 16px}
.config-tabs{gap:7px;padding-bottom:12px;margin-bottom:14px}
.config-tab{padding:8px 12px;border-radius:9px}
.config-tab.active{box-shadow:0 5px 16px rgba(35,153,91,.12)}
.config-section-title{display:flex;align-items:center;gap:7px;margin:0 0 14px;padding-bottom:10px;border-bottom:1px solid rgba(148,163,184,.10);font-size:12px;color:#dce8f4}
.setting-input,.setting-select{height:40px;border-radius:9px;background:rgba(7,17,28,.78)}
.setting-input:hover,.setting-select:hover{border-color:rgba(148,163,184,.32)}
.config-footer{padding-top:13px;border-top:1px solid rgba(148,163,184,.10)}
.super-save{min-width:112px}
.instruction-list{gap:8px}
.instruction-item{border-radius:11px;background:rgba(7,17,28,.52);transition:border-color .16s ease,transform .16s ease}
.instruction-item:hover{transform:translateY(-1px);border-color:rgba(57,208,131,.22)}
.instruction-empty{padding:36px 12px}
.software-update-card .super-card-body{gap:12px}
.update-version-box{padding:12px 13px;border-radius:11px;background:rgba(7,17,28,.72)}
.update-status{border-radius:10px}
.update-changelog{background:rgba(7,17,28,.45)}
.update-actions .btn{min-height:36px;padding:8px 12px}
.support-health-summary{border-radius:11px;background:rgba(7,17,28,.58)}
.support-health-grid{gap:8px}
.support-health-item{min-height:72px;padding:11px 12px;border-radius:11px;background:rgba(7,17,28,.62)}
.support-health-item strong{font-size:12px}
.support-health-item small{line-height:1.7}
.support-actions .btn{min-height:36px;padding:8px 12px}
.system-actions .btn{min-height:70px;background:linear-gradient(180deg,rgba(239,111,117,.09),rgba(239,111,117,.045))}
.system-actions .btn i{display:inline-block;margin-bottom:7px;font-size:15px}
.super-warning{border-radius:10px}

/* More balanced desktop rhythm */
#accounts .super-card-body{padding-top:8px;padding-bottom:8px}
#instructions_admin .super-card-body{min-height:150px}
#support_center .super-card-body,#software_update .super-card-body{padding-top:13px}

/* Scrollbars */
.super-page *{scrollbar-width:thin;scrollbar-color:rgba(111,132,153,.55) rgba(7,17,28,.42)}
.super-page *::-webkit-scrollbar{width:8px;height:8px}
.super-page *::-webkit-scrollbar-track{background:rgba(7,17,28,.42);border-radius:10px}
.super-page *::-webkit-scrollbar-thumb{background:rgba(111,132,153,.52);border-radius:10px;border:2px solid transparent;background-clip:padding-box}
.super-page *::-webkit-scrollbar-thumb:hover{background:rgba(139,159,179,.68);background-clip:padding-box}

/* Responsive */
@media(max-width:1100px){
    .super-shell{padding:20px 18px 44px}
    .super-grid{grid-template-columns:1fr}
    .logs-body{height:300px}
}
@media(max-width:760px){
    .super-shell{padding:14px 10px 34px}
    .super-topbar,.super-intro,.super-card{border-radius:13px}
    .super-intro{align-items:flex-start;flex-direction:column}
    .super-stats{grid-template-columns:1fr}
    .super-stat{min-height:70px}
    .super-card-header{min-height:64px;padding:12px 13px}
    .super-card-body{padding:12px 13px 14px}
    .settings-grid{grid-template-columns:1fr}
    .setting-field.full{grid-column:auto}
    .update-actions,.support-actions{display:grid;grid-template-columns:1fr}
    .update-actions .btn,.support-actions .btn,.support-download{width:100%;text-align:center}
    .system-actions{grid-template-columns:1fr}
}


</style>
<body class="super-page">
<div class="super-shell">
    <nav class="super-topbar">
        <a class="super-brand" href="/">
            <img class="super-brand-logo" src="libs/img/android-chrome-192x192.png" alt="دیده‌بان">
            <span class="super-brand-copy">
                <strong><%-lang.superAdminTitle%></strong>
                <small>مرکز مدیریت و پیکربندی دیده‌بان</small>
            </span>
        </a>
        <div class="dropdown super-menu">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false" title="منو"><i class="fa fa-bars"></i></a>
            <ul class="dropdown-menu">
                <li><a href="#" data-toggle="modal" data-target="#super_about_modal"><i class="fa fa-info-circle"></i>&nbsp; درباره ما</a></li>
                <li><a class="logout"><i class="fa fa-sign-out"></i>&nbsp; <%-lang.Logout%></a></li>
            </ul>
        </div>
    </nav>

    <section class="super-intro">
        <div>
            <h1>مدیریت سامانه دیده‌بان</h1>
            <p>حساب‌های کاربری، پیکربندی اصلی و سرویس‌های سامانه را از این بخش مدیریت کنید.</p>
        </div>
        <div class="super-status"><i class="fa fa-circle"></i> سامانه در دسترس است</div>
    </section>

    <section class="super-stats">
        <div class="super-stat"><span class="super-stat-icon"><i class="fa fa-users"></i></span><div><strong id="accounts_count"><%- (users || []).length %></strong><span>حساب کاربری</span></div></div>
        <div class="super-stat"><span class="super-stat-icon"><i class="fa fa-database"></i></span><div><strong>conf.json</strong><span>فایل پیکربندی فعال</span></div></div>
        <div class="super-stat"><span class="super-stat-icon"><i class="fa fa-shield"></i></span><div><strong>Super</strong><span>سطح دسترسی فعلی</span></div></div>
    </section>

    <main class="super-grid">
        <div class="super-column">
            <section class="super-card" id="accounts">
                <header class="super-card-header">
                    <div>
                        <h2 class="super-card-title"><span class="icon"><i class="fa fa-users"></i></span><%-lang.Accounts%></h2>
                        <div class="super-card-subtitle">مدیریت حساب‌ها و مجوزهای دسترسی</div>
                    </div>
                    <a class="add super-action" title="افزودن حساب"><i class="fa fa-plus"></i></a>
                </header>
                <div class="super-card-body super-table-wrap"><table class="table table-striped"></table></div>
            </section>


            <section class="super-card" id="instructions_admin">
                <header class="super-card-header">
                    <div>
                        <h2 class="super-card-title"><span class="icon"><i class="fa fa-bullhorn"></i></span>دستورالعمل‌ها</h2>
                        <div class="super-card-subtitle">انتشار پیام‌های دائمی برای کاربران سامانه</div>
                    </div>
                    <a class="super-action instruction-add" title="دستورالعمل جدید"><i class="fa fa-plus"></i></a>
                </header>
                <div class="super-card-body">
                    <div class="instruction-list"><div class="instruction-empty"><i class="fa fa-spinner fa-spin"></i><br><br>در حال دریافت دستورالعمل‌ها...</div></div>
                </div>
            </section>

            <section class="super-card" id="logs">
                <header class="super-card-header">
                    <div>
                        <h2 class="super-card-title"><span class="icon"><i class="fa fa-list-alt"></i></span><%-lang['Logs']%></h2>
                        <div class="super-card-subtitle">رخدادهای مدیریتی و پیام‌های سامانه</div>
                    </div>
                    <a class="delete super-action danger" title="حذف گزارش‌ها"><i class="fa fa-trash-o"></i></a>
                </header>
                <div class="logs-body"><table class="table table-striped"></table><div class="logs-empty"><i class="fa fa-inbox fa-2x"></i><br><br>گزارشی برای نمایش وجود ندارد.</div></div>
            </section>
        </div>

        <div class="super-column">
            <form class="super-card config-card" id="config_form">
                <header class="super-card-header">
                    <div>
                        <h2 class="super-card-title"><span class="icon"><i class="fa fa-sliders"></i></span><%-lang['Configuration']%></h2>
                        <div class="super-card-subtitle">تنظیمات سامانه در نمای استاندارد و پیشرفته</div>
                    </div>
                    <small class="config-msg"></small>
                </header>
                <div class="super-card-body">
                    <div class="config-tabs" role="tablist">
                        <button type="button" class="config-tab active" data-pane="general"><i class="fa fa-cog"></i> عمومی</button>
                        <button type="button" class="config-tab" data-pane="database"><i class="fa fa-database"></i> پایگاه داده</button>
                        <button type="button" class="config-tab" data-pane="storage"><i class="fa fa-hdd-o"></i> ذخیره‌سازی</button>
                        <button type="button" class="config-tab" data-pane="mail"><i class="fa fa-envelope-o"></i> ایمیل</button>
                        <button type="button" class="config-tab" data-pane="advanced"><i class="fa fa-code"></i> پیشرفته</button>
                    </div>

                    <div class="config-pane active" data-pane="general">
                        <h3 class="config-section-title"><i class="fa fa-cog"></i> تنظیمات عمومی سامانه</h3>
                        <div class="settings-grid">
                            <div class="setting-field">
                                <label for="cfg_port">پورت وب</label>
                                <input id="cfg_port" class="setting-input" type="number" min="1" max="65535" required>
