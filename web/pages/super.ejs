.support-health-summary{display:flex;align-items:center;gap:10px;padding:12px 14px;border:1px solid #26384a;border-radius:10px;background:#0a1927}.support-health-summary.ok{border-color:#1d7354;color:#91e7bd}.support-health-summary.warning{border-color:#8a6924;color:#f1cf7a}.support-health-summary.danger{border-color:#8e3944;color:#ff9da8}
