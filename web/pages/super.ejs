$.softwareUpdate.render=function(d){
    this.setBusy(false);this.data=d||{}
    this.e.find('.current-version').text(d.currentVersion||'نامشخص')
    this.e.find('.latest-version').text(d.latestVersion||'بررسی نشده')
    this.e.find('.update-source').text(d.manifestUrl?'منبع: '+d.manifestUrl:'')
    var status=this.e.find('.update-status').removeClass('success warning danger')
    var icon='fa-info-circle',text=d.message||'وضعیت نسخه دریافت شد.'
    if(d.updateAvailable){status.addClass('warning');icon='fa-cloud-download'}
    else if(d.checked){status.addClass('success');icon='fa-check-circle'}
    status.html('<i class="fa '+icon+'"></i><span></span>').find('span').text(text)
    var list=this.e.find('.update-changelog ul').empty(),changes=Array.isArray(d.changelog)?d.changelog:[]
    changes.forEach(function(item){$('<li>').text(item).appendTo(list)})
    this.e.find('.update-changelog').toggle(changes.length>0)
    this.e.find('.update-auto,.update-offline').prop('disabled',false)
    if(d.checkedAt)this.e.find('.update-last-check').text('آخرین بررسی: '+new Date(d.checkedAt).toLocaleString('fa-IR'))
}
$.softwareUpdate.error=function(message){
    this.setBusy(false)
    this.e.find('.update-auto,.update-offline').prop('disabled',false);this.e.find('.update-auto').html('<i class="fa fa-refresh"></i> بررسی و به‌روزرسانی خودکار')
    this.e.find('.update-status').removeClass('success warning').addClass('danger').html('<i class="fa fa-exclamation-circle"></i><span></span>').find('span').text(message)
}
$.softwareUpdate.formatBytes=function(bytes){
    bytes=Number(bytes||0);if(!bytes)return '0 B';var units=['B','KB','MB','GB'],i=Math.min(units.length-1,Math.floor(Math.log(bytes)/Math.log(1024)));return (bytes/Math.pow(1024,i)).toFixed(i?1:0)+' '+units[i]
}
$.softwareUpdate.progress=function(d){
    this.setBusy(true);this.e.find('.update-auto,.update-offline').prop('disabled',true);this.e.find('.update-auto').html('<i class="fa fa-spinner fa-spin"></i> در حال به‌روزرسانی...')
    var wrap=this.e.find('.update-progress-wrap').show(),percent=d.percent===null||d.percent===undefined?0:Number(d.percent||0)
    wrap.find('.update-progress-bar').css('width',Math.max(0,Math.min(100,percent))+'%')
    wrap.find('.update-progress-percent').text(d.percent===null||d.percent===undefined?'...':percent+'%')
    var label=d.stage==='offline_prepare'?'در حال آماده‌سازی بارگذاری آفلاین...':d.stage==='offline_upload'?'بارگذاری '+this.formatBytes(d.receivedBytes)+(d.totalBytes?' از '+this.formatBytes(d.totalBytes):''):d.stage==='offline_install'?'در حال آغاز نصب بسته آفلاین...':d.stage==='starting'?'در حال اتصال به سرور انتشار...':'دریافت '+this.formatBytes(d.receivedBytes)+(d.totalBytes?' از '+this.formatBytes(d.totalBytes):'')
    wrap.find('.update-progress-label').text(label)
}
$.softwareUpdate.downloaded=function(d){
    this.setBusy(false)
    this.e.find('.update-auto').prop('disabled',false).html('<i class="fa fa-refresh"></i> بررسی و به‌روزرسانی خودکار')
    this.e.find('.update-offline').prop('disabled',false).html('<i class="fa fa-usb"></i> نصب بسته آفلاین (USB/ZIP)')
    this.e.find('.update-progress-wrap').show().find('.update-progress-bar').css('width','100%')
    this.e.find('.update-progress-percent').text('100%');this.e.find('.update-progress-label').text('دانلود و بررسی SHA-256 کامل شد — '+this.formatBytes(d.size))
    this.e.find('.update-status').removeClass('warning danger').addClass('success').html('<i class="fa fa-check-circle"></i><span></span>').find('span').text(d.message||'بسته به‌روزرسانی آماده نصب است.')
    this.e.find('.update-phase-note').text('فایل '+(d.fileName||'به‌روزرسانی')+' آماده نصب است.')
}
