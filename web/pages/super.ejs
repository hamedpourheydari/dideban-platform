        return
    }
    var select=$('<select class="form-control rollback-select"></select>')
    items.forEach(function(x){$('<option>').val(x.id).text('نسخه '+x.fromVersion+' — قبل از نصب '+x.toVersion+' — '+new Date(x.createdAt).toLocaleString('fa-IR')).appendTo(select)})
    $.confirm.title.html('بازگشت به نسخه پشتیبان')
    $.confirm.body.empty().append('<p class="text-danger"><b>هشدار:</b> فایل‌های برنامه به وضعیت نسخه انتخاب‌شده برمی‌گردند. داده‌ها، تنظیمات و ویدئوها دست‌نخورده می‌مانند.</p>').append(select)
    $.confirm.click({title:'بازیابی و راه‌اندازی مجدد',class:'btn-danger'},function(){var id=$.confirm.body.find('.rollback-select').val();$.softwareUpdate.progress({stage:'rollback',percent:100});$.ccio.cx({f:'software_update',ff:'rollback',backupId:id})})
    $.confirm.e.modal('show')
}

$.supportCenter={e:$('#support_center'),requestTimer:null}
$.supportCenter.clearRequestTimer=function(){if(this.requestTimer){clearTimeout(this.requestTimer);this.requestTimer=null}}
$.supportCenter.startRequestTimer=function(){var self=this;this.clearRequestTimer();this.requestTimer=setTimeout(function(){self.requestTimer=null;self.error('سرور در زمان تعیین‌شده پاسخ نداد. اتصال سرور و خروجی ترمینال Node.js را بررسی کنید.')},30000)}
$.supportCenter.formatBytes=function(bytes){if(bytes===null||bytes===undefined)return 'نامشخص';var units=['B','KB','MB','GB','TB'],i=0,n=Number(bytes)||0;while(n>=1024&&i<units.length-1){n/=1024;i++}return n.toFixed(i?1:0)+' '+units[i]}
$.supportCenter.setBusy=function(state,message){this.e.find('.support-health-check,.support-package-create').prop('disabled',state);this.e.find('.support-progress').toggle(state).find('span').text(message||'در حال انجام عملیات...')}
$.supportCenter.progress=function(message){this.clearRequestTimer();this.setBusy(true,message);this.startRequestTimer()}
$.supportCenter.error=function(message){this.clearRequestTimer();this.setBusy(false);$.confirm.title.html('خطای مرکز پشتیبانی');$.confirm.body.text(message);$.confirm.click({title:'بستن',class:'btn-default'},function(){});$.confirm.e.modal('show')}
$.supportCenter.renderHealth=function(d){
    this.clearRequestTimer();this.setBusy(false);this.e.find('.support-last-check').text('آخرین بررسی: '+new Date(d.checkedAt).toLocaleString('fa-IR'))
    var labels={ok:'سامانه سالم است',warning:'سامانه نیازمند توجه است',danger:'یک یا چند مشکل مهم شناسایی شد'},summary=this.e.find('.support-health-summary').removeClass('ok warning danger').addClass(d.status||'warning')
    summary.find('i').attr('class','fa '+(d.status==='ok'?'fa-check-circle':d.status==='danger'?'fa-times-circle':'fa-exclamation-triangle'));summary.find('span').text(labels[d.status]||labels.warning)
    var grid=this.e.find('.support-health-grid').empty()
    ;(d.checks||[]).forEach(function(x){var icon=x.status==='ok'?'fa-check-circle':x.status==='danger'?'fa-times-circle':'fa-exclamation-triangle';$('<div class="support-health-item"></div>').addClass(x.status).append($('<strong></strong>').append('<i class="fa '+icon+'"></i> ').append(document.createTextNode(x.title))).append($('<small></small>').text(x.message)).appendTo(grid)})
}
$.supportCenter.packageReady=function(d){this.clearRequestTimer();this.renderHealth(d.health||{});this.setBusy(false);this.e.find('.support-download').attr('href',d.url).attr('download',d.fileName).show().html('<i class="fa fa-download"></i> دانلود '+d.fileName+' ('+this.formatBytes(d.size)+')');$.confirm.title.html('بسته پشتیبانی آماده است');$.confirm.body.html('<p>فایل پشتیبانی با موفقیت ساخته شد. لینک دانلود تا ۳۰ دقیقه معتبر است.</p>');$.confirm.click({title:'دانلود فایل',class:'btn-success'},function(){location.href=d.url});$.confirm.e.modal('show')}
$.supportCenter.e.on('click','.support-health-check',function(){
    $.supportCenter.setBusy(true,'در حال بررسی سلامت سیستم...')
    $.supportCenter.startRequestTimer()
    $.ajax({
        url:'/dideban-system-health',
        method:'POST',
        dataType:'text',
        contentType:'application/json; charset=utf-8',
        processData:false,
        cache:false,
        timeout:25000,
        data:JSON.stringify({mail:$user.mail,pass:$user.pass})
    }).done(function(raw){
        var result
        try{result=typeof raw==='string'?JSON.parse(raw):raw}catch(parseError){
            return $.supportCenter.error('پاسخ سرویس سلامت JSON معتبر نبود. برنامه را یک‌بار کامل راه‌اندازی مجدد کنید.')
        }
        if(result&&result.ok!==false&&Array.isArray(result.checks))return $.supportCenter.renderHealth(result)
        $.supportCenter.error((result&&result.msg)||'پاسخ بررسی سلامت معتبر نبود.')
    }).fail(function(xhr,status){
        var result=null
        try{result=JSON.parse(xhr.responseText||'')}catch(e){}
        var message=(result&&result.msg)||'ارتباط با سرویس بررسی سلامت برقرار نشد.'
        if(status==='timeout')message='بررسی سلامت بیش از زمان مجاز طول کشید.'
        else if(xhr&&xhr.status)message+=' (HTTP '+xhr.status+')'
        $.supportCenter.error(message)
    })
})
$.supportCenter.e.on('click','.support-package-create',function(){
    $.confirm.title.html('ایجاد بسته پشتیبانی')
    $.confirm.body.html('<p>گزارش سلامت، مشخصات سیستم، تنظیمات پاک‌سازی‌شده و لاگ‌های اخیر در یک فایل ZIP قرار می‌گیرند.</p><p><b>رمزها، توکن‌ها، کلیدهای API و اطلاعات حساس حذف می‌شوند.</b></p>')
    $.confirm.click({title:'ایجاد بسته',class:'btn-success'},function(){
        $.supportCenter.clearRequestTimer()
        $.supportCenter.setBusy(true,'در حال جمع‌آوری اطلاعات و ساخت ZIP...')
        $.ajax({
            url:'/dideban-support-package',
            method:'POST',
            dataType:'text',
            contentType:'application/json; charset=utf-8',
            processData:false,
            cache:false,
            timeout:150000,
            data:JSON.stringify({mail:$user.mail,pass:$user.pass})
        }).done(function(raw){
            var result
            try{result=typeof raw==='string'?JSON.parse(raw):raw}catch(parseError){
                return $.supportCenter.error('پاسخ سرویس ساخت بسته پشتیبانی JSON معتبر نبود.')
            }
            if(result&&result.ok!==false&&result.url&&result.fileName)return $.supportCenter.packageReady(result)
            $.supportCenter.error((result&&result.msg)||'پاسخ ساخت بسته پشتیبانی معتبر نبود.')
        }).fail(function(xhr,status){
            var result=null
            try{result=JSON.parse(xhr.responseText||'')}catch(e){}
            var message=(result&&result.msg)||'ارتباط با سرویس ساخت بسته پشتیبانی برقرار نشد.'
            if(status==='timeout')message='ساخت بسته پشتیبانی بیش از دو دقیقه طول کشید و متوقف شد.'
            else if(xhr&&xhr.status)message+=' (HTTP '+xhr.status+')'
            $.supportCenter.error(message)
        })
    })
    $.confirm.e.modal('show')
})

//sys controls
$.system={e:$('#system')}
$.system.e.find('[system]').click(function(e){
    switch($(this).attr('system')){
        case'update':
            e.distro=$(this).attr('distro')
            if(!e.distro){e.distro='master'}
            $.confirm.e.modal('show')
            $.confirm.title.html('دیده‌بان به‌روزرسانی شود؟')
            $.confirm.body.html('به‌روزرسانی دیده‌بان باعث بازنویسی فایل‌ها می‌شود. اگر فایل‌ها را شخصاً تغییر داده‌اید، باید دیده‌بان را به‌صورت دستی به‌روزرسانی کنید. به‌روزرسان، آخرین نسخه ' + e.distro + ' را از مخزن رسمی پروژه دریافت خواهد کرد.')
            $.confirm.click({title:'به‌روزرسانی',class:'btn-danger'},function(){
                $.ccio.cx({f:'system',ff:'update',distro:e.distro})
            });
        break;
    }
})
$.system.e.find('[restart]').click(function(e){
    $.confirm.e.modal('show');
    e.html=''
    e.title=''
    e.target=$(this).attr('restart').split(',')
    e.target.forEach(function(v){
        switch(v){
            case'system':
                e.html+='<p>آیا می‌خواهید هسته اصلی (camera.js) مجدداً راه‌اندازی شود؟ افزونه‌ها مجدداً راه‌اندازی نخواهند شد و پس از در دسترس قرار گرفتن دوباره دیده‌بان، مجدداً متصل خواهند شد.</p>'
            break;
            case'cron':
                e.html+='<p>آیا می‌خواهید سرویس زمان‌بندی CRON ‏(cron.js) مجدداً راه‌اندازی شود؟</p>'
            break;
            case'logs':
                e.html+='<p>گزارش‌های کنسول PM2 پاک شوند؟ گزارش‌های ذخیره‌شده در پایگاه داده <b>حذف نخواهند شد</b>.</p>'
            break;
        }
    })
    $.confirm.title.html('راه‌اندازی مجدد؟')
    $.confirm.body.html(e.html)
    $.confirm.click({title:'راه‌اندازی مجدد',class:'btn-danger'},function(){
        $.ccio.cx({f:'system',ff:'restart',target:e.target})
    });
})
