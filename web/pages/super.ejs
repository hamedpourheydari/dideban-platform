                            <div class="config-toolbar"><span class="config-file"><i class="fa fa-file-code-o"></i> conf.json</span><span class="config-hint">ویرایشگر ساختار JSON</span></div>
                            <div id="conf_json"><div class="form-group"><textarea name="json" class="form-control" spellcheck="false"></textarea></div></div>
                        </div>
                    </div>

                    <div class="config-savebar">
