<section class="dideban-overview" id="dideban_overview" aria-label="خلاصه وضعیت سامانه">
    <div class="dideban-overview-shell">
        <div class="dideban-overview-header">
            <div class="dideban-overview-title">
                <strong>مرکز کنترل دیده‌بان</strong>
                <small>نمای لحظه‌ای دوربین‌ها و منابع سامانه</small>
            </div>
            <span class="dideban-system-health"><i class="fa fa-shield"></i> همه سیستم‌ها عادی است</span>
        </div>

        <div class="dideban-stat-grid">
            <article class="dideban-stat-card is-total">
                <div class="dideban-stat-heading"><span class="dideban-stat-icon"><i class="fa fa-video-camera"></i></span><strong>کل دوربین‌ها</strong></div>
                <span class="dideban-stat-value" id="dideban_stat_total">0</span>
                <span class="dideban-stat-label">دوربین ثبت‌شده در سامانه</span>
            </article>
            <article class="dideban-stat-card is-active">
                <div class="dideban-stat-heading"><span class="dideban-stat-icon"><i class="fa fa-play"></i></span><strong>دوربین‌های آنلاین</strong></div>
                <span class="dideban-stat-value" id="dideban_stat_active">0</span>
                <span class="dideban-stat-label">دوربین فعال و در دسترس</span>
            </article>
            <article class="dideban-stat-card is-recording">
                <div class="dideban-stat-heading"><span class="dideban-stat-icon"><i class="fa fa-circle"></i></span><strong>ضبط فعال</strong></div>
                <span class="dideban-stat-value" id="dideban_stat_recording">0</span>
                <span class="dideban-stat-label">در حال ضبط و ذخیره‌سازی</span>
            </article>
            <article class="dideban-stat-card is-cpu has-ring">
                <div class="dideban-stat-heading"><span class="dideban-stat-icon"><i class="fa fa-microchip"></i></span><strong>پردازنده CPU</strong></div>
                <div class="dideban-ring" id="dideban_ring_cpu"><span id="dideban_stat_cpu">--</span></div>
                <span class="dideban-stat-label">مصرف لحظه‌ای پردازنده</span>
            </article>
            <article class="dideban-stat-card is-ram has-ring">
                <div class="dideban-stat-heading"><span class="dideban-stat-icon"><i class="fa fa-tasks"></i></span><strong>حافظه RAM</strong></div>
                <div class="dideban-ring" id="dideban_ring_ram"><span id="dideban_stat_ram">--</span></div>
                <span class="dideban-stat-label">حافظه در حال استفاده</span>
            </article>
            <article class="dideban-stat-card is-disk has-ring">
                <div class="dideban-stat-heading"><span class="dideban-stat-icon"><i class="fa fa-hdd-o"></i></span><strong>فضای ذخیره‌سازی</strong></div>
                <div class="dideban-ring" id="dideban_ring_disk"><span id="dideban_stat_disk">--</span></div>
                <span class="dideban-stat-label">فضای مصرف‌شده دیسک</span>
            </article>
        </div>

        <div class="dideban-quick-actions">
            <a class="dideban-quick-action permission_monitor_edit primary" href="javascript:;" monitor="edit" mid="" ke=""><i class="fa fa-plus-circle"></i><span><strong>افزودن دوربین</strong><small>تعریف دوربین جدید</small></span></a>
            <a class="dideban-quick-action" href="javascript:;" monitor="powerview" mid="" ke=""><i class="fa fa-rss"></i><span><strong>پخش زنده</strong><small>مشاهده آنلاین دوربین‌ها</small></span></a>
            <a class="dideban-quick-action" href="javascript:;" data-toggle="modal" data-target="#videos_viewer"><i class="fa fa-film"></i><span><strong>آرشیو ویدئوها</strong><small>مشاهده ویدئوهای ضبط‌شده</small></span></a>
            <a class="dideban-quick-action" href="javascript:;" monitor="powerview" mid="" ke=""><i class="fa fa-bell-o"></i><span><strong>رویدادها</strong><small>مشاهده رویدادهای اخیر</small></span></a>
            <a class="dideban-quick-action" href="javascript:;" data-toggle="modal" data-target="#logs_modal"><i class="fa fa-bar-chart"></i><span><strong>گزارش‌ها</strong><small>گزارش و آمار سامانه</small></span></a>
            <a class="dideban-quick-action" href="javascript:;" data-toggle="modal" data-target="#settings"><i class="fa fa-gears"></i><span><strong>تنظیمات</strong><small>مدیریت تنظیمات سامانه</small></span></a>
        </div>
    </div>
</section>

<script>
(function () {
    'use strict'
    function text(selector) { var e = document.querySelector(selector); return e ? e.textContent.trim() : '' }
    function percentValue(value) { var n = parseFloat(String(value || '').replace('%','')); return isNaN(n) ? 0 : Math.max(0, Math.min(100,n)) }
    function displayPercent(value) { return value ? (String(value).indexOf('%') === -1 ? value + '%' : value) : '--' }
    function getMonitors() { var r=[]; if(window.$ && $.ccio && $.ccio.mon) $.each($.ccio.mon,function(_,m){if(m&&m.mid)r.push(m)}); return r }
    function setRing(id,value){var e=document.getElementById(id);if(e)e.style.setProperty('--value',percentValue(value))}
    function updateOverview() {
        var monitors=getMonitors(),active=0,recording=0
        monitors.forEach(function(m){var mode=String(m.mode||'').toLowerCase();if(mode&&mode!=='stop'&&mode!=='disabled')active++;if(mode==='record')recording++})
        var cpu=text('.cpu_load .percent'),ram=text('.ram_load .percent'),disk=text('.diskUsed .percent')
        document.getElementById('dideban_stat_total').textContent=monitors.length
        document.getElementById('dideban_stat_active').textContent=active
        document.getElementById('dideban_stat_recording').textContent=recording
        document.getElementById('dideban_stat_cpu').textContent=displayPercent(cpu)
        document.getElementById('dideban_stat_ram').textContent=displayPercent(ram)
        document.getElementById('dideban_stat_disk').textContent=displayPercent(disk)
        setRing('dideban_ring_cpu',cpu);setRing('dideban_ring_ram',ram);setRing('dideban_ring_disk',disk)
    }
    document.addEventListener('DOMContentLoaded',function(){updateOverview();window.setInterval(updateOverview,5000)})
})()
</script>
