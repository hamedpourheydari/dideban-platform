        </a>
        <% } %>
    </div>

    <div class="dideban-monitor-section">
        <div class="dideban-section-title">
            <span><i class="fa fa-video-camera" aria-hidden="true"></i> &#1583;&#1608;&#1585;&#1576;&#1740;&#1606;&#8204;&#1607;&#1575;</span>
            <button type="button" class="dideban-icon-button" class_toggle="list-blocks" data-target="#left_menu" title="Change monitor list view">
