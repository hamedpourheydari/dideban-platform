<% include blocks/header %>

<%
    if (screen) {
        screen = screen.toLowerCase()
    }
%>

<div class="dideban-bg" dir="rtl">
    <div class="dideban-bg-shade"></div>

    <main class="container dideban-login-shell">
        <div class="row">
            <div class="col-sm-8 col-sm-offset-2 col-md-6 col-md-offset-3 col-lg-4 col-lg-offset-4">
                <section class="panel panel-login" aria-labelledby="login-title">

                    <div class="panel-heading">
                        <img
                            src="/libs/img/icon/apple-touch-icon-76x76.png"
                            class="login-logo"
                            alt="لوگوی سامانه دیده‌بان">
                    </div>

                    <div class="panel-body">
                        <header class="login-header">
                            <h1 id="login-title">سامانه مدیریت دوربین‌ها</h1>
                            <p>برای ورود، اطلاعات حساب کاربری خود را وارد کنید.</p>
                        </header>

                        <form
                            id="login-form"
                            method="post"
                            dir="rtl"
                            autocomplete="on">

                            <input
                                type="hidden"
                                name="machineID"
                                id="machineID"
                                value="">

                            <div class="form-group">
                                <label class="sr-only" for="email">ایمیل</label>

                                <div class="login-input-wrap">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <i class="fa fa-envelope-o"></i>
                                    </span>

                                    <input
                                        type="text"
                                        name="mail"
                                        id="email"
                                        tabindex="1"
                                        class="monospace form-control"
                                        placeholder="ایمیل"
                                        autocomplete="username"
                                        inputmode="email"
                                        value="">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="sr-only" for="pass">رمز عبور</label>

                                <div class="login-input-wrap">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <i class="fa fa-lock"></i>
                                    </span>

                                    <input
                                        type="password"
                                        name="pass"
                                        id="pass"
                                        tabindex="2"
                                        class="monospace form-control"
                                        placeholder="رمز عبور"
                                        autocomplete="current-password">

                                    <button
                                        type="button"
                                        id="toggle-password"
                                        class="password-toggle"
                                        aria-label="نمایش رمز عبور"
                                        aria-pressed="false">
                                        <i class="fa fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <div
                                class="form-group f_i_input f_i_ldap"
                                style="display:none">

                                <label class="sr-only" for="key">کلید گروه</label>

                                <div class="login-input-wrap">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <i class="fa fa-key"></i>
                                    </span>

                                    <input
                                        type="text"
                                        name="key"
                                        id="key"
                                        tabindex="3"
                                        class="monospace form-control"
                                        placeholder="کلید گروه"
                                        autocomplete="off">
                                </div>
                            </div>

                            <div class="login-options">
                                <div class="login-function-select">
                                    <label for="login-function">صفحه ورود</label>

                                    <select
                                        id="login-function"
                                        class="form-control"
                                        name="function"
                                        selector="f_i"
                                        tabindex="4">

                                        <% switch(screen) {
                                            case 'super': %>

                                            <option value="super">
                                                مدیر ارشد
                                            </option>

                                        <% break;

                                            case 'admin': %>

                                            <option value="admin">
                                                مدیر
                                            </option>

                                        <% break;

                                            default: %>

                                            <option value="dash" selected>
                                                داشبورد
                                            </option>

                                            <% if (config.productType === 'Pro') { %>

                                                <option value="ldap">
                                                    ورود LDAP
                                                </option>

                                            <% } %>

                                            <option value="streamer">
                                                پخش‌کننده
                                            </option>

                                            <option value="cam">
                                                دوربین متحرک (پخش‌کننده نسخه ۲)
                                            </option>

                                        <% break;
                                        } %>

                                    </select>
                                </div>

                                <div
                                    class="remember-container"
                                    title="مرا به خاطر بسپار">

                                    <label
                                        class="mdl-switch mdl-js-switch mdl-js-ripple-effect"
                                        for="remember_me">

                                        <input
                                            type="checkbox"
                                            id="remember_me"
                                            value="1"
                                            name="remember"
                                            class="mdl-switch__input">

                                        <span class="mdl-switch__label">
                                            مرا به خاطر بسپار
                                        </span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-group login-submit-group">
                                <button
                                    type="submit"
                                    name="login-submit"
                                    id="login-submit"
                                    tabindex="5"
                                    class="btn btn-login btn-block">
                                    <span>ورود</span>
                                    <i class="fa fa-sign-in" aria-hidden="true"></i>
                                </button>
                            </div>
                        </form>

                        <div class="login-security-note">
                            <i class="fa fa-shield" aria-hidden="true"></i>
                            <span>دسترسی شما امن و محرمانه است.</span>
                        </div>
                    </div>
                </section>

                <footer class="login-footer">
                    <strong>دیده‌بان پلتفرم</strong>
                    <span class="login-footer-separator">|</span>
                    <span>تمامی حقوق محفوظ است.</span>
                </footer>
            </div>
        </div>
    </main>
</div>

<script src="libs/js/material.min.js"></script>

<script>
    /*
     * Dideban localStorage keys
     *
     * کلیدهای legacy فقط برای مهاجرت اطلاعات نسخه قبلی استفاده می‌شوند.
     * پس از مهاجرت موفق، کلید قدیمی حذف می‌شود.
     */
    var legacyLoginStorageKey = 'ShinobiLogin_' + location.host
    var legacyAuthStorageKey = 'ShinobiAuth_' + location.host

    var loginStorageKey = 'DidebanLogin_' + location.host
    var authStorageKey = 'DidebanAuth_' + location.host

    /*
     * اگر ورود قبلی ناموفق بوده، اطلاعات Remember Me پاک شود.
     * کلید جدید و قدیمی هر دو حذف می‌شوند تا اطلاعات اشتباه باقی نماند.
     */
    <% var failedLogin; if (failedLogin === true) { %>
        localStorage.removeItem(loginStorageKey)
        localStorage.removeItem(legacyLoginStorageKey)
    <% } %>

    /*
 * مهاجرت اطلاعات ورود ذخیره‌شده از نسخه قدیمی به دیده‌بان
 */
    if (
        !localStorage.getItem(loginStorageKey) &&
        localStorage.getItem(legacyLoginStorageKey)
    ) {
        localStorage.setItem(
            loginStorageKey,
            localStorage.getItem(legacyLoginStorageKey)
        )

        localStorage.removeItem(legacyLoginStorageKey)
    }

  /*
 * مهاجرت شناسه دستگاه از نسخه قدیمی به دیده‌بان
 */
    if (
        !localStorage.getItem(authStorageKey) &&
        localStorage.getItem(legacyAuthStorageKey)
    ) {
        localStorage.setItem(
            authStorageKey,
            localStorage.getItem(legacyAuthStorageKey)
        )

        localStorage.removeItem(legacyAuthStorageKey)
    }

    /*
     * Login controller
     */
    $.ccio = {
        f: $('#login-form'),
        ls: localStorage.getItem(loginStorageKey),
        auth: localStorage.getItem(authStorageKey)
    }

    /*
     * تولید شناسه تصادفی برای دستگاه
     */
    $.ccio.gid = function (length) {
        if (!length) {
            length = 10
        }

        var result = ''
        var characters =
            'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'

        for (var i = 0; i < length; i++) {
            result += characters.charAt(
                Math.floor(Math.random() * characters.length)
            )
        }

        return result
    }

    /*
     * اگر شناسه دستگاه وجود ندارد، یک شناسه جدید ایجاد شود.
     */
    if (!$.ccio.auth || $.ccio.auth === '') {
        $.ccio.auth = $.ccio.gid(20)

        localStorage.setItem(
            authStorageKey,
            $.ccio.auth
        )
    }

    /*
     * عملیات پس از آماده‌شدن صفحه
     */
    $(document).ready(function () {
        $('#machineID').val($.ccio.auth)

        /*
         * نمایش و مخفی‌سازی رمز عبور
         */
        $('#toggle-password').on('click', function () {
            var button = $(this)
            var passwordInput = $('#pass')
            var icon = button.find('i')
            var showPassword =
                passwordInput.attr('type') === 'password'

            passwordInput.attr(
                'type',
                showPassword ? 'text' : 'password'
            )

            button.attr(
                'aria-pressed',
                showPassword ? 'true' : 'false'
            )

            button.attr(
                'aria-label',
                showPassword
                    ? 'مخفی کردن رمز عبور'
                    : 'نمایش رمز عبور'
            )

            icon.toggleClass('fa-eye', !showPassword)
            icon.toggleClass('fa-eye-slash', showPassword)
        })
    })

    /*
     * ذخیره یا حذف اطلاعات Remember Me هنگام ارسال فرم
     */
    $.ccio.f.submit(function (event) {
        $('input').css('border-color', '')

        event.e = $(this)
        event.s = event.e.serializeObject()
        event.inputs = event.e.find('input,button')

        if (event.s.remember) {
            localStorage.setItem(
                loginStorageKey,
                JSON.stringify({
                    mail: event.s.mail,
                    pass: event.s.pass,
                    function: event.s.function
                })
            )
        } else {
            localStorage.removeItem(loginStorageKey)
        }
    })

    /*
     * بازیابی اطلاعات ذخیره‌شده Remember Me
     */
    if ($.ccio.ls) {
        try {
            $.ccio.ls = JSON.parse($.ccio.ls)

            $.each($.ccio.ls, function (name, value) {
                var input =
                    $.ccio.f.find('[name="' + name + '"]')

                if (input.attr('type') === 'checkbox') {
                    input.prop('checked', true)
                } else {
                    input.val(value)
                }
            })

            $.ccio.f
                .find('[name="remember"]')
                .prop('checked', true)

            /*
             * این رفتار در نسخه اصلی وجود داشته و فرم را
             * به‌صورت خودکار ارسال می‌کند.
             */
            $.ccio.f.submit()
        } catch (error) {
            console.warn(
                'Dideban: invalid saved login information.',
                error
            )

            localStorage.removeItem(loginStorageKey)
            $.ccio.ls = null
        }
    }

    /*
     * ثبت نوع ورود روی دکمه
     */
    $('[name="function"]').change(function () {
        $('#login-submit').attr(
            'data-login-mode',
            $(this).val()
        )
    })

    /*
     * مدیریت Selectorهای فرم
     */
    $('[selector]').change(function () {
        var selectedValue = $(this).val()
        var selectorName = $(this).attr('selector')

        $('.' + selectorName + '_input').hide()

        $('.' + selectorName + '_' + selectedValue).show()

        $('.' + selectorName + '_text').text(
            $(this).find('option:selected').text()
        )
    }).change()
</script>