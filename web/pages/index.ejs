<% include blocks/header %>

<link rel="stylesheet" href="libs/css/dideban.css">

<%
    if (screen) {
        screen = screen.toLowerCase()
    }
%>

<div class="shinobi-bg" dir="rtl">
    <div class="shinobi-bg-shade"></div>

    <main class="container dideban-login-shell">
        <div class="row">
            <div class="col-sm-8 col-sm-offset-2 col-md-6 col-md-offset-3 col-lg-4 col-lg-offset-4">
                <section class="panel panel-login" aria-labelledby="login-title">

                    <div class="panel-heading">
                        <img
                            src="/libs/img/icon/apple-touch-icon-76x76.png"
                            class="login-logo"
                            alt="لوگوی سامانه دیده‌بان">
                    </div>

                    <div class="panel-body">
                        <header class="login-header">
                            <h1 id="login-title">سامانه مدیریت دوربین‌ها</h1>
                            <p>برای ورود، اطلاعات حساب کاربری خود را وارد کنید.</p>
                        </header>

                        <form
                            id="login-form"
                            method="post"
                            dir="rtl"
                            autocomplete="on">

                            <input
                                type="hidden"
                                name="machineID"
                                id="machineID"
                                value="">

                            <div class="form-group">
                                <label class="sr-only" for="email">ایمیل</label>

                                <div class="login-input-wrap">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <i class="fa fa-envelope-o"></i>
                                    </span>

                                    <input
                                        type="text"
                                        name="mail"
                                        id="email"
                                        tabindex="1"
                                        class="monospace form-control"
                                        placeholder="ایمیل"
                                        autocomplete="username"
                                        inputmode="email"
                                        value="">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="sr-only" for="pass">رمز عبور</label>

                                <div class="login-input-wrap">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <i class="fa fa-lock"></i>
                                    </span>

                                    <input
                                        type="password"
                                        name="pass"
                                        id="pass"
                                        tabindex="2"
                                        class="monospace form-control"
                                        placeholder="رمز عبور"
                                        autocomplete="current-password">

                                    <button
                                        type="button"
                                        id="toggle-password"
                                        class="password-toggle"
                                        aria-label="نمایش رمز عبور"
                                        aria-pressed="false">
                                        <i class="fa fa-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <div
                                class="form-group f_i_input f_i_ldap"
                                style="display:none">

                                <label class="sr-only" for="key">کلید گروه</label>

                                <div class="login-input-wrap">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <i class="fa fa-key"></i>
                                    </span>

                                    <input
                                        type="text"
                                        name="key"
                                        id="key"
                                        tabindex="3"
                                        class="monospace form-control"
                                        placeholder="کلید گروه"
                                        autocomplete="off">
                                </div>
                            </div>

                            <div class="login-options">
                                <div class="login-function-select">
                                    <label for="login-function">صفحه ورود</label>

                                    <select
                                        id="login-function"
                                        class="form-control"
                                        name="function"
                                        selector="f_i"
                                        tabindex="4">

                                        <% switch(screen) {
                                            case 'super': %>

                                            <option value="super">
                                                مدیر ارشد
                                            </option>

                                        <% break;

                                            case 'admin': %>

                                            <option value="admin">
                                                مدیر
                                            </option>

                                        <% break;

                                            default: %>

                                            <option value="dash" selected>
                                                داشبورد
                                            </option>

                                            <% if (config.productType === 'Pro') { %>

                                                <option value="ldap">
                                                    ورود LDAP
                                                </option>

                                            <% } %>

                                            <option value="streamer">
                                                پخش‌کننده
                                            </option>

                                            <option value="cam">
                                                دوربین متحرک (پخش‌کننده نسخه ۲)
                                            </option>

                                        <% break;
                                        } %>

                                    </select>
                                </div>

                                <div
                                    class="remember-container"
                                    title="مرا به خاطر بسپار">

                                    <label
                                        class="mdl-switch mdl-js-switch mdl-js-ripple-effect"
                                        for="remember_me">

                                        <input
                                            type="checkbox"
                                            id="remember_me"
                                            value="1"
                                            name="remember"
                                            class="mdl-switch__input">

                                        <span class="mdl-switch__label">
                                            مرا به خاطر بسپار
                                        </span>
                                    </label>
                                </div>
                            </div>

                            <div class="form-group login-submit-group">
                                <button
                                    type="submit"
                                    name="login-submit"
                                    id="login-submit"
                                    tabindex="5"
                                    class="btn btn-login btn-block">
                                    <span>ورود</span>
                                    <i class="fa fa-sign-in" aria-hidden="true"></i>
                                </button>
                            </div>
                        </form>

                        <div class="login-security-note">
                            <i class="fa fa-shield" aria-hidden="true"></i>
                            <span>دسترسی شما امن و محرمانه است.</span>
                        </div>
                    </div>
                </section>

                <footer class="login-footer">
                    <strong>دیده‌بان پلتفرم</strong>
                    <span class="login-footer-separator">|</span>
                    <span>تمامی حقوق محفوظ است.</span>
                </footer>
            </div>
        </div>
    </main>
</div>

<script src="libs/js/material.min.js"></script>

<script>
    <% var failedLogin; if (failedLogin === true) { %>
        localStorage.removeItem('ShinobiLogin_' + location.host)
    <% } %>

    $.ccio = {
        f: $('#login-form'),
        ls: localStorage.getItem('ShinobiLogin_' + location.host),
        auth: localStorage.getItem('ShinobiAuth_' + location.host)
    }

    $.ccio.gid = function (x) {
        if (!x) {
            x = 10
        }

        var t = ''
        var p = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'

        for (var i = 0; i < x; i++) {
            t += p.charAt(Math.floor(Math.random() * p.length))
        }

        return t
    }

    if (!$.ccio.auth || $.ccio.auth === '') {
        $.ccio.auth = $.ccio.gid(20)

        localStorage.setItem(
            'ShinobiAuth_' + location.host,
            $.ccio.auth
        )
    }

    $(document).ready(function () {
        $('#machineID').val($.ccio.auth)

        $('#toggle-password').on('click', function () {
            var button = $(this)
            var passwordInput = $('#pass')
            var icon = button.find('i')
            var showPassword = passwordInput.attr('type') === 'password'

            passwordInput.attr('type', showPassword ? 'text' : 'password')
            button.attr('aria-pressed', showPassword ? 'true' : 'false')
            button.attr(
                'aria-label',
                showPassword ? 'مخفی کردن رمز عبور' : 'نمایش رمز عبور'
            )

            icon.toggleClass('fa-eye', !showPassword)
            icon.toggleClass('fa-eye-slash', showPassword)
        })
    })

    $.ccio.f.submit(function (e) {
        $('input').css('border-color', '')

        e.e = $(this)
        e.s = e.e.serializeObject()
        e.inputs = e.e.find('input,button')

        if (e.s.remember) {
            localStorage.setItem(
                'ShinobiLogin_' + location.host,
                JSON.stringify({
                    mail: e.s.mail,
                    pass: e.s.pass,
                    function: e.s.function
                })
            )
        } else {
            localStorage.removeItem(
                'ShinobiLogin_' + location.host
            )
        }
    })

    if ($.ccio.ls) {
        $.ccio.ls = JSON.parse($.ccio.ls)

        $.each($.ccio.ls, function (n, v) {
            n = $.ccio.f.find('[name="' + n + '"]')

            if (n.attr('type') === 'checkbox') {
                n.prop('checked', true)
            } else {
                n.val(v)
            }
        })

        $.ccio.f
            .find('[name="remember"]')
            .prop('checked', true)

        $.ccio.f.submit()
    }

    $('[name="function"]').change(function () {
        $('#login-submit').attr(
            'data-login-mode',
            $(this).val()
        )
    })

    $('[selector]').change(function () {
        var e = {}

        e.v = $(this).val()
        e.a = $(this).attr('selector')

        $('.' + e.a + '_input').hide()
        $('.' + e.a + '_' + e.v).show()

        $('.' + e.a + '_text').text(
            $(this).find('option:selected').text()
        )
    }).change()
</script>
