<script>
(function(){
    'use strict'
    var rows={}
    var initialPopupShown=false
    function esc(v){return $('<div>').text(v==null?'':v).html()}
    function endpoint(id){return '/'+encodeURIComponent($user.auth_token||$user.auth)+'/dideban/instructions/'+encodeURIComponent($user.ke)+(id?'/'+encodeURIComponent(id)+'/read':'')}
    function updateBadge(list){
        var unread=0
        $.each(list||[],function(_,x){if(!x.read_at)unread++})
        $('#dideban_instruction_badge,#dideban_instruction_sidebar_badge').text(unread).toggle(unread>0)
        $('.dideban-instructions-nav').toggleClass('has-unread',unread>0)
    }
    function draw(list){
        rows={}
        var html=''
        $.each(list||[],function(_,x){
            rows[x.id]=x
            html+='<article class="dideban-instruction-card '+(x.read_at?'is-read':'is-unread')+' '+(x.priority==='high'?'is-high':'')+'" data-id="'+esc(x.id)+'">'
            html+='<header><div><h4>'+(x.pinned?'<i class="fa fa-thumb-tack"></i> ':'')+esc(x.title)+'</h4><span>'+(x.priority==='high'?'مهم':'عادی')+(x.read_at?' · مطالعه‌شده':' · جدید')+'</span></div><i class="fa fa-chevron-down"></i></header>'
            html+='<div class="dideban-instruction-body"><div class="dideban-instruction-text">'+esc(x.body).replace(/\r?\n/g,'<br>')+'</div>'
            if(x.has_attachment||x.attachment_url||x.attachment_path||x.attachment_name){
                var attachmentUrl=x.attachment_url||('/dideban/instruction-attachment-by-id/'+encodeURIComponent(String(x.id||'')))
                var attachmentSize=x.attachment_size?Math.max(1,Math.round(Number(x.attachment_size)/1024))+' کیلوبایت':''
                html+='<div class="dideban-instruction-attachment-box"><div class="dideban-instruction-attachment-title"><i class="fa fa-paperclip"></i> این دستورالعمل فایل پیوست دارد</div><a class="dideban-instruction-attachment" href="'+esc(attachmentUrl)+'" target="_blank" rel="noopener" download><i class="fa fa-file-o"></i><span><strong>'+esc(x.attachment_name||'فایل پیوست')+'</strong><small>'+esc(attachmentSize)+'</small></span><span class="dideban-download-label"><i class="fa fa-download"></i> دانلود فایل</span></a></div>'
            }
            if(x.require_ack&&!x.acknowledged_at)html+='<button class="btn btn-success dideban-instruction-ack"><i class="fa fa-check"></i> مطالعه و درک کردم</button>'
            else if(x.acknowledged_at)html+='<div class="dideban-instruction-acked"><i class="fa fa-check-circle"></i> تأیید مطالعه ثبت شده است</div>'
            html+='</div></article>'
        })
        $('#dideban_instructions_list').html(html||'<div class="dideban-instruction-empty"><i class="fa fa-inbox fa-3x"></i><p>دستورالعملی برای شما منتشر نشده است.</p></div>')
        updateBadge(list)
    }
    function maybeShowImportant(list){
        if(initialPopupShown)return
        var urgent=null
        $.each(list||[],function(_,x){
            if(!x.read_at&&(x.priority==='high'||(x.require_ack&&!x.acknowledged_at))){urgent=x;return false}
        })
        if(urgent){
            initialPopupShown=true
            $('#dideban_instructions_modal').modal({backdrop:urgent.require_ack?'static':true,keyboard:!urgent.require_ack})
            setTimeout(function(){
                var card=$('.dideban-instruction-card[data-id="'+urgent.id+'"]')
                card.addClass('open')
                if(card.length)$('#dideban_instructions_modal .modal-body').animate({scrollTop:card.position().top},250)
            },250)
        }
    }
    function load(showImportant){
        return $.getJSON(endpoint()).done(function(r){
            if(r&&r.ok){draw(r.instructions||[]);if(showImportant)maybeShowImportant(r.instructions||[])}
            else $('#dideban_instructions_list').html('<div class="dideban-instruction-empty">دریافت دستورالعمل‌ها ممکن نشد.<br><small>'+esc(r&&r.msg||'خطای نامشخص')+'</small></div>')
        }).fail(function(){$('#dideban_instructions_list').html('<div class="dideban-instruction-empty">ارتباط با سرور برقرار نشد.</div>')})
    }
    function mark(id,ack){return $.ajax({url:endpoint(id),method:'POST',data:{acknowledged:ack?'1':'0'},dataType:'json'})}
    $('#dideban_instructions_modal').on('show.bs.modal',function(){load(false)})
    $('#dideban_instructions_list').on('click','.dideban-instruction-card header',function(){
        var card=$(this).closest('.dideban-instruction-card'),id=card.data('id')
        card.toggleClass('open')
        if(rows[id]&&!rows[id].read_at){mark(id,false).done(function(){rows[id].read_at=new Date().toISOString();card.removeClass('is-unread').addClass('is-read');updateBadge(Object.keys(rows).map(function(k){return rows[k]}))})}
    })
    $('#dideban_instructions_list').on('click','.dideban-instruction-ack',function(e){
        e.stopPropagation()
        var button=$(this),card=button.closest('.dideban-instruction-card'),id=card.data('id')
        button.prop('disabled',true)
        mark(id,true).done(function(r){
            if(r&&r.ok){
                rows[id].read_at=rows[id].read_at||new Date().toISOString()
                rows[id].acknowledged_at=new Date().toISOString()
                button.replaceWith('<div class="dideban-instruction-acked"><i class="fa fa-check-circle"></i> تأیید مطالعه ثبت شد</div>')
                card.removeClass('is-unread').addClass('is-read')
                updateBadge(Object.keys(rows).map(function(k){return rows[k]}))
            }else button.prop('disabled',false)
        }).fail(function(){button.prop('disabled',false)})
    })
    $(document).on('dideban_instruction_changed',function(){load(false)})
    $(function(){load(true);setInterval(function(){load(false)},30000)})
})()
</script>

